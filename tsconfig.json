{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "./worker-configuration.d.ts"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "better-auth/adapters/drizzle": ["./node_modules/better-auth/dist/adapters/drizzle-adapter/index.d.mts"]
    }
  }
}
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "case-files",
	"compatibility_date": "2026-10-07",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"secrets": {
		"required": ["EVENT_SECRET", "RATE_LIMIT_SECRET", "ADMIN_SECRET"]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "case-files-db",
			"database_id": "9e58723d-67f8-42f6-8750-4cd1ccd507ca",
			"migrations_dir": "migrations",
			"migrations_pattern": "migrations/*/migration.sql"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "EVENT_LIVE", "class_name": "EventLive" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventLive"] }],
	// Limits must match the *_LIMIT_PERIOD_SECONDS constants in src/lib/auth/constants.ts.
	"ratelimits": [
		{ "name": "LOGIN_ROLL_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "LOGIN_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 200, "period": 60 } },
		{ "name": "PLAYER_ACTION_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
		{ "name": "ADMIN_LOGIN_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
	]
}

{
  "name": "case-files",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply case-files-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply case-files-db --remote",
    "db:seed:local": "wrangler d1 execute case-files-db --local --file scripts/seed-dev.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 .wrangler/state/v3/do .wrangler/state/v3/ratelimit && pnpm db:migrate:local && pnpm db:seed:local",
    "replay:export": "node scripts/export-leaderboard.mjs",
    "replay:scrub": "node scripts/scrub-static-replay.mjs",
    "event:create": "tsx scripts/create-event.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "drizzle-orm": "1.0.0-rc.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}

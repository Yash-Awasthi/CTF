---
// Hint Marketplace — Community-submitted hints for CTF challenges
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hint Marketplace // CTF</title>
  <style>
    :root {
      --bg: #0a0a0f;
      --surface: #12121a;
      --surface-2: #1a1a25;
      --border: #2a2a35;
      --text: #c8c8d0;
      --muted: #666680;
      --green: #00ff88;
      --red: #ff4466;
      --amber: #ffaa00;
      --blue: #4488ff;
      --purple: #aa66ff;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      background: var(--bg);
      color: var(--text);
      font-size: 13px;
      line-height: 1.6;
    }
    .container { max-width: 1000px; margin: 0 auto; padding: 20px; }
    h1 {
      font-size: 24px;
      color: var(--green);
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .subtitle { color: var(--muted); font-size: 12px; margin-bottom: 24px; }

    /* Tabs */
    .tabs { display: flex; gap: 2px; margin-bottom: 20px; }
    .tab {
      padding: 10px 20px;
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--muted);
      cursor: pointer;
      font-family: inherit;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: all 0.2s;
    }
    .tab:hover { color: var(--text); background: var(--surface-2); }
    .tab.active { color: var(--green); border-color: var(--green); background: var(--surface-2); }

    /* Filters */
    .filters {
      display: flex;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .filter-group { display: flex; flex-direction: column; gap: 4px; }
    .filter-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
    select, input {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 12px;
      font-family: inherit;
      font-size: 12px;
      border-radius: 2px;
    }
    select:focus, input:focus { outline: none; border-color: var(--green); }

    /* Hint cards */
    .hint-card {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 16px;
      margin-bottom: 12px;
      border-left: 3px solid var(--muted);
      transition: border-color 0.2s;
    }
    .hint-card:hover { border-left-color: var(--green); }
    .hint-card.featured { border-left-color: var(--amber); background: var(--surface-2); }
    .hint-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 8px;
    }
    .hint-meta {
      display: flex;
      gap: 12px;
      font-size: 11px;
      color: var(--muted);
    }
    .hint-category {
      font-size: 10px;
      padding: 2px 8px;
      border-radius: 2px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .cat-nudge { background: rgba(0,255,136,0.1); color: var(--green); }
    .cat-partial { background: rgba(68,136,255,0.1); color: var(--blue); }
    .cat-detailed { background: rgba(170,102,255,0.1); color: var(--purple); }
    .cat-solution_adjacent { background: rgba(255,170,0,0.1); color: var(--amber); }

    .hint-preview {
      color: var(--text);
      margin-bottom: 10px;
      font-style: italic;
      opacity: 0.8;
    }
    .hint-content {
      background: var(--bg);
      padding: 12px;
      border: 1px solid var(--border);
      margin-bottom: 10px;
      display: none;
      white-space: pre-wrap;
    }
    .hint-content.revealed { display: block; }
    .hint-locked {
      text-align: center;
      padding: 12px;
      background: var(--bg);
      border: 1px dashed var(--border);
      color: var(--muted);
      font-size: 11px;
    }

    .hint-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .hint-actions { display: flex; gap: 12px; align-items: center; }
    .vote-btn {
      background: none;
      border: 1px solid var(--border);
      color: var(--muted);
      padding: 4px 10px;
      cursor: pointer;
      font-family: inherit;
      font-size: 11px;
      transition: all 0.2s;
    }
    .vote-btn:hover { border-color: var(--text); color: var(--text); }
    .vote-btn.up:hover { border-color: var(--green); color: var(--green); }
    .vote-btn.down:hover { border-color: var(--red); color: var(--red); }

    .hint-cost {
      font-size: 12px;
      color: var(--amber);
    }
    .hint-cost.free { color: var(--green); }

    .rating-bar {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
    }
    .rating-fill {
      width: 60px;
      height: 4px;
      background: var(--border);
      border-radius: 2px;
      overflow: hidden;
    }
    .rating-fill-inner {
      height: 100%;
      background: var(--green);
      border-radius: 2px;
    }

    /* Submit form */
    .submit-form {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 20px;
      margin-bottom: 20px;
      display: none;
    }
    .submit-form.visible { display: block; }
    .form-row { margin-bottom: 12px; }
    .form-row label {
      display: block;
      font-size: 10px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 4px;
    }
    .form-row textarea {
      width: 100%;
      min-height: 80px;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 10px;
      font-family: inherit;
      font-size: 12px;
      resize: vertical;
    }
    .form-row textarea:focus { outline: none; border-color: var(--green); }
    .submit-btn {
      background: var(--green);
      color: var(--bg);
      border: none;
      padding: 10px 24px;
      font-family: inherit;
      font-size: 12px;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
    }
    .submit-btn:hover { opacity: 0.9; }

    /* Leaderboard */
    .leaderboard-table { width: 100%; border-collapse: collapse; }
    .leaderboard-table th {
      text-align: left;
      font-size: 10px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 8px 12px;
      border-bottom: 1px solid var(--border);
    }
    .leaderboard-table td {
      padding: 8px 12px;
      border-bottom: 1px solid var(--border);
      font-size: 12px;
    }
    .leaderboard-table tr:hover td { background: var(--surface-2); }
    .rank-badge {
      display: inline-block;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      text-align: center;
      line-height: 24px;
      font-size: 11px;
      font-weight: bold;
    }
    .rank-1 { background: rgba(255,215,0,0.2); color: #ffd700; }
    .rank-2 { background: rgba(192,192,192,0.2); color: #c0c0c0; }
    .rank-3 { background: rgba(205,127,50,0.2); color: #cd7f32; }

    @media (max-width: 700px) {
      .filters { flex-direction: column; }
      .hint-footer { flex-direction: column; gap: 8px; align-items: flex-start; }
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Hint Marketplace</h1>
    <p class="subtitle">Community-submitted hints. Rate quality. Earn reputation.</p>

    <div class="tabs">
      <button class="tab active" onclick="showTab('browse')">Browse</button>
      <button class="tab" onclick="showTab('submit')">Submit Hint</button>
      <button class="tab" onclick="showTab('leaderboard')">Leaderboard</button>
    </div>

    <div id="tab-browse">
      <div class="filters">
        <div class="filter-group">
          <span class="filter-label">Challenge</span>
          <select id="filter-challenge" onchange="filterHints()">
            <option value="">All Challenges</option>
            <option value="q07">Q7 — RSA basics</option>
            <option value="q08">Q8 — SQL injection</option>
            <option value="q09">Q9 — Buffer overflow</option>
          </select>
        </div>
        <div class="filter-group">
          <span class="filter-label">Category</span>
          <select id="filter-category" onchange="filterHints()">
            <option value="">All</option>
            <option value="nudge">Nudge</option>
            <option value="partial">Partial</option>
            <option value="detailed">Detailed</option>
            <option value="solution_adjacent">Solution-Adjacent</option>
          </select>
        </div>
        <div class="filter-group">
          <span class="filter-label">Sort</span>
          <select id="filter-sort" onchange="filterHints()">
            <option value="rating">Top Rated</option>
            <option value="newest">Newest</option>
            <option value="cost_low">Cheapest</option>
            <option value="popular">Most Popular</option>
          </select>
        </div>
      </div>

      <div id="hints-list"></div>
    </div>

    <div id="tab-submit" style="display:none">
      <div class="submit-form visible">
        <div class="form-row">
          <label>Challenge</label>
          <select id="submit-challenge">
            <option value="q07">Q7 — RSA basics</option>
            <option value="q08">Q8 — SQL injection</option>
            <option value="q09">Q9 — Buffer overflow</option>
          </select>
        </div>
        <div class="form-row">
          <label>Category</label>
          <select id="submit-category">
            <option value="nudge">Nudge (subtle direction)</option>
            <option value="partial">Partial (some approach)</option>
            <option value="detailed">Detailed (step-by-step)</option>
            <option value="solution_adjacent">Solution-Adjacent (almost there)</option>
          </select>
        </div>
        <div class="form-row">
          <label>Hint Content (first line = preview)</label>
          <textarea id="submit-content" placeholder="First line is shown as preview...&#10;Full hint content here..."></textarea>
        </div>
        <button class="submit-btn" onclick="submitHint()">Submit Hint</button>
      </div>
    </div>

    <div id="tab-leaderboard" style="display:none">
      <table class="leaderboard-table">
        <thead>
          <tr>
            <th>Rank</th>
            <th>Author</th>
            <th>Hints</th>
            <th>Upvotes</th>
            <th>Rating</th>
            <th>Reputation</th>
          </tr>
        </thead>
        <tbody id="leaderboard-body"></tbody>
      </table>
    </div>
  </div>

  <script>
    // Mock data
    const HINTS = [
      { id: 'h1', challengeId: 'q07', author: 'alice', category: 'nudge', preview: 'The modulus has a small factor — try factordb.com', content: 'The modulus N = p * q where p and q are unusually small primes. Use factordb.com to factor N, then compute d = e^-1 mod phi(N). Decrypt with c^d mod N.', cost: 5, upvotes: 42, downvotes: 3, rating: 0.93, featured: true },
      { id: 'h2', challengeId: 'q07', author: 'bob', category: 'partial', preview: 'Use Python with PyCryptodome for the math', content: 'from Crypto.PublicKey import RSA\nfrom Crypto.Cipher import PKCS1_OAEP\nkey = RSA.construct((N, e))\n# Factor N first, then compute private exponent\nd = pow(e, -1, (p-1)*(q-1))\ncipher = PKCS1_OAEP.new(key)', cost: 15, upvotes: 28, downvotes: 5, rating: 0.85, featured: true },
      { id: 'h3', challengeId: 'q08', author: 'charlie', category: 'nudge', preview: 'Check what happens when you type a single quote', content: "Try entering a single quote ' in the username field. If you get a SQL error, the input isn't sanitized. Then try: ' OR 1=1 -- as the password.", cost: 5, upvotes: 35, downvotes: 2, rating: 0.95, featured: true },
      { id: 'h4', challengeId: 'q09', author: 'diana', category: 'detailed', preview: 'Buffer is 64 bytes, return address at offset 72', content: 'Step 1: Find the offset using pattern_create/pattern_offset\nStep 2: Find the win function address with objdump -d\nStep 3: Craft payload: padding(72) + win_addr\nStep 4: Send payload to overwrite return address\nStep 5: win() is called, flag is printed', cost: 30, upvotes: 19, downvotes: 1, rating: 0.95, featured: false },
    ];

    const LEADERBOARD = [
      { author: 'alice', hints: 12, upvotes: 156, rating: 0.91, reputation: 95 },
      { author: 'charlie', hints: 8, upvotes: 134, rating: 0.88, reputation: 82 },
      { author: 'bob', hints: 15, upvotes: 98, rating: 0.78, reputation: 71 },
      { author: 'diana', hints: 5, upvotes: 67, rating: 0.85, reputation: 58 },
    ];

    function renderHints(hints) {
      const el = document.getElementById('hints-list');
      el.innerHTML = hints.map(h => {
        const catClass = `cat-${h.category}`;
        const ratingPct = Math.round(h.rating * 100);
        return `<div class="hint-card ${h.featured ? 'featured' : ''}">
          <div class="hint-header">
            <div class="hint-meta">
              <span class="hint-category ${catClass}">${h.category.replace('_', '-')}</span>
              <span>${h.challengeId.toUpperCase()}</span>
              <span>by ${h.author}</span>
              ${h.featured ? '<span style="color:var(--amber)">★ Featured</span>' : ''}
            </div>
          </div>
          <div class="hint-preview">"${h.preview}"</div>
          <div class="hint-content" id="content-${h.id}">${h.content}</div>
          <div class="hint-locked" id="locked-${h.id}">🔒 ${h.cost} points to reveal full hint</div>
          <div class="hint-footer">
            <div class="hint-actions">
              <button class="vote-btn up" onclick="vote('${h.id}', true)">▲ ${h.upvotes}</button>
              <button class="vote-btn down" onclick="vote('${h.id}', false)">▼ ${h.downvotes}</button>
              <div class="rating-bar">
                <div class="rating-fill"><div class="rating-fill-inner" style="width:${ratingPct}%"></div></div>
                <span>${ratingPct}%</span>
              </div>
            </div>
            <button class="hint-cost" onclick="revealHint('${h.id}')">🔒 ${h.cost} pts</button>
          </div>
        </div>`;
      }).join('');
    }

    function renderLeaderboard() {
      const el = document.getElementById('leaderboard-body');
      el.innerHTML = LEADERBOARD.map((l, i) => {
        const rankClass = i < 3 ? `rank-${i+1}` : '';
        return `<tr>
          <td><span class="rank-badge ${rankClass}">${i+1}</span></td>
          <td style="color:var(--green)">${l.author}</td>
          <td>${l.hints}</td>
          <td>${l.upvotes}</td>
          <td>${Math.round(l.rating*100)}%</td>
          <td style="color:${l.reputation >= 80 ? 'var(--green)' : l.reputation >= 50 ? 'var(--amber)' : 'var(--muted)'}">${l.reputation}</td>
        </tr>`;
      }).join('');
    }

    function filterHints() {
      const challenge = document.getElementById('filter-challenge').value;
      const category = document.getElementById('filter-category').value;
      const sort = document.getElementById('filter-sort').value;
      let filtered = [...HINTS];
      if (challenge) filtered = filtered.filter(h => h.challengeId === challenge);
      if (category) filtered = filtered.filter(h => h.category === category);
      if (sort === 'rating') filtered.sort((a,b) => b.rating - a.rating);
      if (sort === 'newest') filtered.sort((a,b) => b.id.localeCompare(a.id));
      if (sort === 'cost_low') filtered.sort((a,b) => a.cost - b.cost);
      if (sort === 'popular') filtered.sort((a,b) => (b.upvotes+b.downvotes) - (a.upvotes+a.downvotes));
      renderHints(filtered);
    }

    function revealHint(id) {
      document.getElementById(`content-${id}`).classList.add('revealed');
      document.getElementById(`locked-${id}`).style.display = 'none';
    }

    function vote(id, up) {
      const hint = HINTS.find(h => h.id === id);
      if (hint) {
        if (up) hint.upvotes++; else hint.downvotes++;
        hint.rating = hint.upvotes / (hint.upvotes + hint.downvotes);
        filterHints();
      }
    }

    function submitHint() {
      const content = document.getElementById('submit-content').value;
      if (content.trim()) {
        alert('Hint submitted! It will appear after review.');
        document.getElementById('submit-content').value = '';
      }
    }

    function showTab(name) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('[id^="tab-"]').forEach(d => d.style.display = 'none');
      event.target.classList.add('active');
      document.getElementById(`tab-${name}`).style.display = 'block';
    }

    // Init
    renderHints(HINTS);
    renderLeaderboard();
  </script>
</body>
</html>

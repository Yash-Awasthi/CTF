---
import Layout from '../layouts/Layout.astro';

const endpoints = [
  {
    method: 'POST',
    path: '/api/auth/login',
    description: 'Log in as a participant; sets the session cookie',
    params: [
      { name: 'eventSlug', type: 'string', required: true },
      { name: 'rollNumber', type: 'number', required: true },
      { name: 'password', type: 'string', required: true },
    ],
    response: '{ ok, redirect } + session cookie (form posts get a 303), or { error }',
  },
  {
    method: 'POST',
    path: '/api/auth/logout',
    description: 'Revoke the current session',
    params: [],
    response: 'redirect or { ok }',
  },
  {
    method: 'GET',
    path: '/api/event/state',
    description: 'Event state and server-side timer (auth required)',
    params: [],
    response: '{ state, startedAt, endsAt, remainingSeconds }',
  },
  {
    method: 'GET',
    path: '/api/challenges/:slot',
    description: 'Public data for one challenge; only your current or solved slots are readable',
    params: [],
    response: '{ slot, title, tier, basePoints, publicData }',
  },
  {
    method: 'POST',
    path: '/api/submit',
    description: 'Submit an answer for your current challenge; every attempt is recorded and throttled',
    params: [
      { name: 'slot', type: 'number', required: true, description: '1-30' },
      { name: 'answer', type: 'string', required: true, description: '1-500 characters' },
    ],
    response: '{ correct, ... } or { error }',
  },
  {
    method: 'POST',
    path: '/api/hint',
    description: 'Reveal a hint in order; the first hint halves the challenge score',
    params: [
      { name: 'slot', type: 'number', required: true },
      { name: 'hintNumber', type: 'number', required: true, description: '1 or 2, in order' },
    ],
    response: '{ hint } or { error: "out_of_order" }',
  },
  {
    method: 'GET',
    path: '/api/events/stream',
    description: 'Server-sent events: state changes, first blood, announcements',
    params: [],
    response: 'text/event-stream',
  },
  {
    method: 'GET',
    path: '/api/leaderboard',
    description: 'Final standings; 403 until results are published',
    params: [
      { name: 'event', type: 'string', required: true, description: 'Event slug' },
    ],
    response: '{ eventSlug, state, leaderboard: [{ rank, rollNumber, score }] }',
  },
];

const methodColors = {
  GET: '#00ff88',
  POST: '#ffaa00',
  PUT: '#00aaff',
  DELETE: '#ff4444',
};
---

<Layout title="CTF API Documentation">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #0a0e1a;
      color: #e0e0e0;
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      line-height: 1.6;
      padding: 2rem;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
    }

    h1 {
      font-size: 2rem;
      color: #00ff88;
      margin-bottom: 0.5rem;
      text-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
    }

    .subtitle {
      color: #666;
      margin-bottom: 2rem;
      font-size: 0.9rem;
    }

    .endpoint {
      background: #0f1423;
      border: 1px solid #1a2035;
      border-radius: 8px;
      margin-bottom: 1rem;
      overflow: hidden;
      transition: border-color 0.3s;
    }

    .endpoint:hover {
      border-color: #00ff88;
    }

    .endpoint-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem;
      cursor: pointer;
    }

    .method {
      padding: 0.25rem 0.75rem;
      border-radius: 4px;
      font-weight: bold;
      font-size: 0.8rem;
      min-width: 60px;
      text-align: center;
    }

    .method-GET { background: rgba(0, 255, 136, 0.2); color: #00ff88; }
    .method-POST { background: rgba(255, 170, 0, 0.2); color: #ffaa00; }
    .method-PUT { background: rgba(0, 170, 255, 0.2); color: #00aaff; }
    .method-DELETE { background: rgba(255, 68, 68, 0.2); color: #ff4444; }

    .path {
      color: #e0e0e0;
      font-weight: 500;
    }

    .description {
      color: #888;
      margin-left: auto;
      font-size: 0.9rem;
    }

    .endpoint-body {
      display: none;
      padding: 1rem;
      border-top: 1px solid #1a2035;
    }

    .endpoint-body.show {
      display: block;
    }

    .params-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
    }

    .params-table th {
      text-align: left;
      padding: 0.5rem;
      border-bottom: 1px solid #1a2035;
      color: #888;
      font-size: 0.8rem;
      text-transform: uppercase;
    }

    .params-table td {
      padding: 0.5rem;
      border-bottom: 1px solid #0f1423;
    }

    .required {
      color: #ff4444;
      font-size: 0.8rem;
    }

    .optional {
      color: #666;
      font-size: 0.8rem;
    }

    .response {
      margin-top: 1rem;
      padding: 1rem;
      background: #0a0e1a;
      border-radius: 4px;
      border-left: 3px solid #00ff88;
    }

    .response-label {
      color: #888;
      font-size: 0.8rem;
      margin-bottom: 0.5rem;
    }

    .response code {
      color: #00ff88;
      font-size: 0.9rem;
    }

    .arrow {
      transition: transform 0.3s;
    }

    .arrow.open {
      transform: rotate(90deg);
    }
  </style>

  <div class="container">
    <h1>🔑 CTF API Documentation</h1>
    <p class="subtitle">Authentication • Challenges • Scoring • Teams</p>

    {endpoints.map((endpoint) => (
      <div class="endpoint">
        <div class="endpoint-header" onclick="this.nextElementSibling.classList.toggle('show'); this.querySelector('.arrow').classList.toggle('open')">
          <span class={`method method-${endpoint.method}`}>{endpoint.method}</span>
          <span class="path">{endpoint.path}</span>
          <span class="description">{endpoint.description}</span>
          <span class="arrow">▶</span>
        </div>
        <div class="endpoint-body">
          {endpoint.params.length > 0 && (
            <table class="params-table">
              <thead>
                <tr>
                  <th>Parameter</th>
                  <th>Type</th>
                  <th>Required</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                {endpoint.params.map((param) => (
                  <tr>
                    <td>{param.name}</td>
                    <td style="color: #00aaff;">{param.type}</td>
                    <td>
                      {param.required ? (
                        <span class="required">required</span>
                      ) : (
                        <span class="optional">optional</span>
                      )}
                    </td>
                    <td style="color: #888;">{param.description || ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          <div class="response">
            <div class="response-label">Response:</div>
            <code>{endpoint.response}</code>
          </div>
        </div>
      </div>
    ))}
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin — Case 71-C">
  <style>
    :root {
      --noir-bg: #0a0e1a;
      --noir-surface: #111827;
      --noir-card: #0f1629;
      --noir-border: #1e293b;
      --accent-green: #00ff88;
      --accent-amber: #ffaa00;
      --accent-red: #ff4444;
      --accent-purple: #a855f7;
      --accent-cyan: #06b6d4;
      --text-primary: #e2e8f0;
      --text-muted: #64748b;
      --text-dim: #475569;
    }

    body { background: var(--noir-bg); font-family: 'Inter', system-ui, sans-serif; }

    .admin-header {
      border-bottom: 1px solid var(--noir-border);
      padding: 24px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .stat-card {
      background: var(--noir-card);
      border: 1px solid var(--noir-border);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
    }
    .stat-value {
      font-size: 2rem;
      font-weight: 700;
      font-family: 'JetBrains Mono', monospace;
    }
    .stat-label {
      font-size: 11px;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-top: 4px;
    }
    .nav-tab {
      padding: 8px 20px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      border: 1px solid transparent;
      background: transparent;
      color: var(--text-muted);
    }
    .nav-tab:hover { color: var(--text-primary); background: rgba(255,255,255,0.05); }
    .nav-tab.active {
      background: rgba(0,255,136,0.1);
      color: var(--accent-green);
      border-color: rgba(0,255,136,0.3);
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    .data-table th {
      text-align: left;
      padding: 10px 16px;
      color: var(--text-dim);
      border-bottom: 1px solid var(--noir-border);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-family: 'JetBrains Mono', monospace;
    }
    .data-table td {
      padding: 10px 16px;
      border-bottom: 1px solid var(--noir-border);
    }
    .data-table tr:hover { background: rgba(255,255,255,0.02); }
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      font-family: 'JetBrains Mono', monospace;
    }
    .search-input {
      background: var(--noir-card);
      border: 1px solid var(--noir-border);
      border-radius: 8px;
      padding: 8px 16px;
      color: var(--text-primary);
      font-size: 13px;
      outline: none;
      width: 280px;
    }
    .search-input:focus { border-color: var(--accent-green); }
    .search-input::placeholder { color: var(--text-dim); }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }
    .bar-chart {
      display: flex;
      align-items: flex-end;
      gap: 4px;
      height: 120px;
      padding-top: 8px;
    }
    .bar {
      flex: 1;
      border-radius: 3px 3px 0 0;
      min-width: 12px;
      transition: height 0.3s;
      position: relative;
    }
    .bar:hover::after {
      content: attr(data-tooltip);
      position: absolute;
      bottom: 100%;
      left: 50%;
      transform: translateX(-50%);
      background: var(--noir-surface);
      border: 1px solid var(--noir-border);
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 11px;
      white-space: nowrap;
      color: var(--text-primary);
      z-index: 10;
    }
    .setting-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid var(--noir-border);
    }
    .setting-input {
      background: var(--noir-card);
      border: 1px solid var(--noir-border);
      border-radius: 6px;
      padding: 6px 12px;
      color: var(--text-primary);
      font-size: 13px;
      width: 100px;
      text-align: center;
      font-family: 'JetBrains Mono', monospace;
    }
    .toggle {
      width: 40px; height: 22px;
      border-radius: 11px;
      background: var(--noir-border);
      cursor: pointer;
      position: relative;
      transition: background 0.2s;
    }
    .toggle.on { background: var(--accent-green); }
    .toggle::after {
      content: '';
      position: absolute;
      top: 3px; left: 3px;
      width: 16px; height: 16px;
      border-radius: 50%;
      background: white;
      transition: transform 0.2s;
    }
    .toggle.on::after { transform: translateX(18px); }

    .timeline-event {
      display: flex;
      gap: 12px;
      padding: 8px 0;
      align-items: flex-start;
    }
    .timeline-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      margin-top: 6px;
      flex-shrink: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .bar { transition: none; }
      .toggle::after { transition: none; }
    }
  </style>

  <div class="min-h-screen" style="background: var(--noir-bg);">
    <!-- Admin Header -->
    <div class="admin-header">
      <div>
        <h1 style="font-size:20px;font-weight:700;color:var(--text-primary);">
          🕵️ Case 71-C <span style="color:var(--text-dim);font-weight:400;">Admin</span>
        </h1>
        <p style="font-size:12px;color:var(--text-dim);font-family:'JetBrains Mono',monospace;margin-top:2px;">
          EVENT: Winter 2026 • STATUS: DRAFT
        </p>
      </div>
      <div style="display:flex;gap:8px;">
        <button class="nav-tab active" onclick="showTab('challenges')">📋 Challenges</button>
        <button class="nav-tab" onclick="showTab('leaderboard')">🏆 Leaderboard</button>
        <button class="nav-tab" onclick="showTab('stats')">📊 Statistics</button>
        <button class="nav-tab" onclick="showTab('timeline')">⏱️ Timeline</button>
        <button class="nav-tab" onclick="showTab('settings')">⚙️ Settings</button>
      </div>
    </div>

    <div class="p-8">
      <!-- Stats Overview -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="stat-card">
          <div class="stat-value" style="color:var(--accent-green);">0</div>
          <div class="stat-label">Participants</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" style="color:var(--accent-amber);">30</div>
          <div class="stat-label">Challenges</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" style="color:var(--accent-cyan);">0</div>
          <div class="stat-label">Total Solves</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" style="color:var(--accent-purple);">—</div>
          <div class="stat-label">Avg Solve Time</div>
        </div>
      </div>

      <!-- Challenges Tab -->
      <div id="tab-challenges" class="tab-panel active">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
          <h2 style="font-size:14px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;font-family:'JetBrains Mono',monospace;">
            Challenge Management
          </h2>
          <input type="text" class="search-input" placeholder="🔍 Search challenges..." oninput="filterChallenges(this.value)">
        </div>
        <div style="background:var(--noir-card);border:1px solid var(--noir-border);border-radius:12px;overflow:hidden;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Slot</th>
                <th>Title</th>
                <th>Tier</th>
                <th>Points</th>
                <th>Hints</th>
                <th>Solves</th>
                <th>Attribution</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="challenge-table">
            </tbody>
          </table>
        </div>
      </div>

      <!-- Leaderboard Tab -->
      <div id="tab-leaderboard" class="tab-panel">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
          <h2 style="font-size:14px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;font-family:'JetBrains Mono',monospace;">
            Participant Leaderboard
          </h2>
          <div style="display:flex;gap:8px;">
            <input type="text" class="search-input" placeholder="🔍 Search participants..." oninput="filterLeaderboard(this.value)">
            <select class="search-input" style="width:120px;">
              <option>All</option><option>Top 10</option><option>Top 25</option>
            </select>
          </div>
        </div>
        <div style="background:var(--noir-card);border:1px solid var(--noir-border);border-radius:12px;overflow:hidden;">
          <table class="data-table">
            <thead>
              <tr><th>#</th><th>Participant</th><th>Score</th><th>Solved</th><th>Hints Used</th><th>Last Active</th></tr>
            </thead>
            <tbody id="leaderboard-table"></tbody>
          </table>
        </div>
      </div>

      <!-- Statistics Tab -->
      <div id="tab-stats" class="tab-panel">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Solves per challenge -->
          <div style="background:var(--noir-card);border:1px solid var(--noir-border);border-radius:12px;padding:24px;">
            <h3 style="font-size:12px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px;font-family:'JetBrains Mono',monospace;">
              Solves Per Challenge
            </h3>
            <div class="bar-chart" id="solves-chart"></div>
            <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--text-dim);margin-top:8px;font-family:'JetBrains Mono',monospace;">
              <span>Q1</span><span>Q10</span><span>Q20</span><span>Q30</span>
            </div>
          </div>

          <!-- Solve time distribution -->
          <div style="background:var(--noir-card);border:1px solid var(--noir-border);border-radius:12px;padding:24px;">
            <h3 style="font-size:12px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px;font-family:'JetBrains Mono',monospace;">
              Avg Solve Time (minutes)
            </h3>
            <div class="bar-chart" id="time-chart"></div>
            <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--text-dim);margin-top:8px;font-family:'JetBrains Mono',monospace;">
              <span>Q1</span><span>Q10</span><span>Q20</span><span>Q30</span>
            </div>
          </div>

          <!-- Tier distribution -->
          <div style="background:var(--noir-card);border:1px solid var(--noir-border);border-radius:12px;padding:24px;">
            <h3 style="font-size:12px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px;font-family:'JetBrains Mono',monospace;">
              Tier Distribution
            </h3>
            <div style="display:flex;gap:16px;justify-content:center;padding:20px 0;">
              <div style="text-align:center;">
                <div style="font-size:36px;font-weight:700;color:var(--accent-green);font-family:monospace;">8</div>
                <div style="font-size:11px;color:var(--text-dim);">EASY</div>
              </div>
              <div style="text-align:center;">
                <div style="font-size:36px;font-weight:700;color:var(--accent-amber);font-family:monospace;">10</div>
                <div style="font-size:11px;color:var(--text-dim);">MEDIUM</div>
              </div>
              <div style="text-align:center;">
                <div style="font-size:36px;font-weight:700;color:var(--accent-red);font-family:monospace;">8</div>
                <div style="font-size:11px;color:var(--text-dim);">HARD</div>
              </div>
              <div style="text-align:center;">
                <div style="font-size:36px;font-weight:700;color:var(--accent-purple);font-family:monospace;">4</div>
                <div style="font-size:11px;color:var(--text-dim);">CAPSTONE</div>
              </div>
            </div>
          </div>

          <!-- Hint usage -->
          <div style="background:var(--noir-card);border:1px solid var(--noir-border);border-radius:12px;padding:24px;">
            <h3 style="font-size:12px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px;font-family:'JetBrains Mono',monospace;">
              Hint Usage Rate
            </h3>
            <div style="padding:20px 0;">
              <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
                <span style="font-size:13px;color:var(--text-muted);">No hints</span>
                <span style="font-size:13px;color:var(--accent-green);font-family:monospace;">72%</span>
              </div>
              <div class="h-2 rounded-full" style="background:var(--noir-border);">
                <div style="width:72%;height:100%;background:var(--accent-green);border-radius:8px;"></div>
              </div>
              <div style="display:flex;justify-content:space-between;margin-top:12px;margin-bottom:8px;">
                <span style="font-size:13px;color:var(--text-muted);">1 hint used</span>
                <span style="font-size:13px;color:var(--accent-amber);font-family:monospace;">20%</span>
              </div>
              <div class="h-2 rounded-full" style="background:var(--noir-border);">
                <div style="width:20%;height:100%;background:var(--accent-amber);border-radius:8px;"></div>
              </div>
              <div style="display:flex;justify-content:space-between;margin-top:12px;margin-bottom:8px;">
                <span style="font-size:13px;color:var(--text-muted);">2+ hints</span>
                <span style="font-size:13px;color:var(--accent-red);font-family:monospace;">8%</span>
              </div>
              <div class="h-2 rounded-full" style="background:var(--noir-border);">
                <div style="width:8%;height:100%;background:var(--accent-red);border-radius:8px;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Timeline Tab -->
      <div id="tab-timeline" class="tab-panel">
        <h2 style="font-size:14px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px;font-family:'JetBrains Mono',monospace;">
          Event Timeline
        </h2>
        <div style="background:var(--noir-card);border:1px solid var(--noir-border);border-radius:12px;padding:24px;">
          <div id="timeline-list">
            <div class="timeline-event">
              <div class="timeline-dot" style="background:var(--accent-green);"></div>
              <div>
                <div style="font-size:13px;color:var(--text-primary);">Event created</div>
                <div style="font-size:11px;color:var(--text-dim);font-family:monospace;">2026-01-15 09:00 UTC</div>
              </div>
            </div>
            <div class="timeline-event">
              <div class="timeline-dot" style="background:var(--accent-cyan);"></div>
              <div>
                <div style="font-size:13px;color:var(--text-primary);">30 challenges loaded</div>
                <div style="font-size:11px;color:var(--text-dim);font-family:monospace;">2026-01-15 09:02 UTC</div>
              </div>
            </div>
            <div class="timeline-event">
              <div class="timeline-dot" style="background:var(--accent-amber);"></div>
              <div>
                <div style="font-size:13px;color:var(--text-primary);">Event status changed to READY</div>
                <div style="font-size:11px;color:var(--text-dim);font-family:monospace;">2026-01-15 09:05 UTC</div>
              </div>
            </div>
          </div>
          <p style="color:var(--text-dim);font-size:12px;margin-top:16px;text-align:center;">
            More events will appear as the competition runs.
          </p>
        </div>
      </div>

      <!-- Settings Tab -->
      <div id="tab-settings" class="tab-panel">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div style="background:var(--noir-card);border:1px solid var(--noir-border);border-radius:12px;padding:24px;">
            <h3 style="font-size:12px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px;font-family:'JetBrains Mono',monospace;">
              Scoring
            </h3>
            <div class="setting-row">
              <div><div style="font-size:13px;color:var(--text-primary);">Time Decay</div>
              <div style="font-size:11px;color:var(--text-dim);">Score reduces over event duration</div></div>
              <div class="toggle on" onclick="this.classList.toggle('on')"></div>
            </div>
            <div class="setting-row">
              <div><div style="font-size:13px;color:var(--text-primary);">Hint Penalty</div>
              <div style="font-size:11px;color:var(--text-dim);">50% score reduction per hint</div></div>
              <div class="toggle on" onclick="this.classList.toggle('on')"></div>
            </div>
            <div class="setting-row">
              <div><div style="font-size:13px;color:var(--text-primary);">Minimum Score</div>
              <div style="font-size:11px;color:var(--text-dim);">Floor as % of base points</div></div>
              <input type="text" class="setting-input" value="25%">
            </div>
          </div>

          <div style="background:var(--noir-card);border:1px solid var(--noir-border);border-radius:12px;padding:24px;">
            <h3 style="font-size:12px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px;font-family:'JetBrains Mono',monospace;">
              Anti-Cheat
            </h3>
            <div class="setting-row">
              <div><div style="font-size:13px;color:var(--text-primary);">Attribution Detection</div>
              <div style="font-size:11px;color:var(--text-dim);">Trace copied answers to source</div></div>
              <div class="toggle on" onclick="this.classList.toggle('on')"></div>
            </div>
            <div class="setting-row">
              <div><div style="font-size:13px;color:var(--text-primary);">Flag Format</div>
              <div style="font-size:11px;color:var(--text-dim);">Expected answer format</div></div>
              <input type="text" class="setting-input" value="case_{N}" style="width:140px;">
            </div>
            <div class="setting-row">
              <div><div style="font-size:13px;color:var(--text-primary);">Max Attempts</div>
              <div style="font-size:11px;color:var(--text-dim);">0 = unlimited</div></div>
              <input type="text" class="setting-input" value="0">
            </div>
          </div>

          <div style="background:var(--noir-card);border:1px solid var(--noir-border);border-radius:12px;padding:24px;">
            <h3 style="font-size:12px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px;font-family:'JetBrains Mono',monospace;">
              Event Timing
            </h3>
            <div class="setting-row">
              <div><div style="font-size:13px;color:var(--text-primary);">Duration</div>
              <div style="font-size:11px;color:var(--text-dim);">Max event length</div></div>
              <input type="text" class="setting-input" value="6h">
            </div>
            <div class="setting-row">
              <div><div style="font-size:13px;color:var(--text-primary);">Start Time</div>
              <div style="font-size:11px;color:var(--text-dim);">UTC kickoff</div></div>
              <input type="text" class="setting-input" value="—">
            </div>
          </div>

          <div style="background:var(--noir-card);border:1px solid var(--noir-border);border-radius:12px;padding:24px;">
            <h3 style="font-size:12px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px;font-family:'JetBrains Mono',monospace;">
              Authentication
            </h3>
            <div class="setting-row">
              <div><div style="font-size:13px;color:var(--text-primary);">Roll-Number Login</div>
              <div style="font-size:11px;color:var(--text-dim);">Username = password = roll#</div></div>
              <div class="toggle on" onclick="this.classList.toggle('on')"></div>
            </div>
            <div class="setting-row">
              <div><div style="font-size:13px;color:var(--text-primary);">Rate Limit</div>
              <div style="font-size:11px;color:var(--text-dim);">Failures per 5min window</div></div>
              <input type="text" class="setting-input" value="10">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const TIER_COLORS = { easy: '#00ff88', medium: '#ffaa00', hard: '#ff4444', capstone: '#a855f7' };
    const TIER_LABELS = { easy: 'EASY', medium: 'MEDIUM', hard: 'HARD', capstone: 'CAPSTONE' };

    // Mock data
    const challenges = [];
    for (let i = 1; i <= 30; i++) {
      const tiers = ['easy','easy','easy','easy','easy','easy','easy','easy',
                     'medium','medium','medium','medium','medium','medium','medium','medium','medium','medium',
                     'hard','hard','hard','hard','hard','hard','hard','hard',
                     'capstone','capstone','capstone','capstone'];
      challenges.push({
        slot: i, title: `Case ${i}`, tier: tiers[i-1],
        basePoints: {easy: 100, medium: 200, hard: 350, capstone: 500}[tiers[i-1]],
        hints: Math.floor(Math.random() * 3) + 1,
        solves: Math.floor(Math.random() * 15),
        attribution: i % 3 !== 0,
        solveTime: Math.floor(Math.random() * 45) + 5,
      });
    }

    const participants = [];
    const names = ['Detective Noir','Phantom Lens','Red Thread','Cold Case Files','The Archivist',
                   'Midnight Runner','Silent Witness','Paper Trail','Code Breaker','Shadow Bureau',
                   'Deep Cover','Blind Spot','Open Secret','False Lead','Dead Drop',
                   'Cover Story','Loose End','Clean Slate','Hard Copy','Soft Target'];
    for (let i = 0; i < names.length; i++) {
      participants.push({
        rank: i + 1, name: names[i],
        score: Math.floor(Math.random() * 3000) + 500,
        solved: Math.floor(Math.random() * 30) + 1,
        hints: Math.floor(Math.random() * 10),
        lastActive: `2026-01-${String(Math.max(1, 15 - i)).padStart(2, '0')}`,
      });
    }
    participants.sort((a, b) => b.score - a.score);
    participants.forEach((p, i) => p.rank = i + 1);

    function showTab(name) {
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
      document.getElementById('tab-' + name)?.classList.add('active');
      event.target.classList.add('active');
    }

    function renderChallenges(filter = '') {
      const tbody = document.getElementById('challenge-table');
      const filtered = challenges.filter(c =>
        c.title.toLowerCase().includes(filter.toLowerCase()) ||
        c.tier.includes(filter.toLowerCase())
      );
      tbody.innerHTML = filtered.map(c => `
        <tr>
          <td style="font-family:monospace;color:var(--text-dim);">${String(c.slot).padStart(2,'0')}</td>
          <td style="color:var(--text-primary);">${c.title}</td>
          <td><span class="badge" style="background:${TIER_COLORS[c.tier]}15;color:${TIER_COLORS[c.tier]};">${TIER_LABELS[c.tier]}</span></td>
          <td style="font-family:monospace;color:var(--text-muted);">${c.basePoints}</td>
          <td style="font-family:monospace;color:var(--text-dim);">${c.hints}</td>
          <td style="font-family:monospace;color:${c.solves > 10 ? 'var(--accent-green)' : 'var(--text-dim)'};">${c.solves}</td>
          <td style="color:${c.attribution ? 'var(--accent-cyan)' : 'var(--text-dim)'};">${c.attribution ? '✓' : '—'}</td>
          <td><button style="background:none;border:1px solid var(--noir-border);border-radius:4px;padding:2px 8px;color:var(--text-muted);font-size:11px;cursor:pointer;">Edit</button></td>
        </tr>
      `).join('');
    }

    function renderLeaderboard(filter = '') {
      const tbody = document.getElementById('leaderboard-table');
      const filtered = participants.filter(p =>
        p.name.toLowerCase().includes(filter.toLowerCase())
      );
      tbody.innerHTML = filtered.map(p => `
        <tr>
          <td style="font-family:monospace;color:${p.rank <= 3 ? 'var(--accent-amber)' : 'var(--text-dim)'};">
            ${p.rank <= 3 ? ['🥇','🥈','🥉'][p.rank-1] : '#'+p.rank}
          </td>
          <td style="color:var(--text-primary);">${p.name}</td>
          <td style="font-family:monospace;color:var(--accent-green);">${p.score.toLocaleString()}</td>
          <td style="font-family:monospace;color:var(--text-muted);">${p.solved}/30</td>
          <td style="font-family:monospace;color:var(--text-dim);">${p.hints}</td>
          <td style="font-family:monospace;color:var(--text-dim);font-size:12px;">${p.lastActive}</td>
        </tr>
      `).join('');
    }

    function renderCharts() {
      // Solves chart
      const solvesEl = document.getElementById('solves-chart');
      const maxSolves = Math.max(...challenges.map(c => c.solves), 1);
      solvesEl.innerHTML = challenges.map(c => {
        const h = Math.max(5, (c.solves / maxSolves) * 100);
        return `<div class="bar" style="height:${h}%;background:${TIER_COLORS[c.tier]};" data-tooltip="Q${c.slot}: ${c.solves} solves"></div>`;
      }).join('');

      // Time chart
      const timeEl = document.getElementById('time-chart');
      const maxTime = Math.max(...challenges.map(c => c.solveTime), 1);
      timeEl.innerHTML = challenges.map(c => {
        const h = Math.max(5, (c.solveTime / maxTime) * 100);
        return `<div class="bar" style="height:${h}%;background:${TIER_COLORS[c.tier]};" data-tooltip="Q${c.slot}: ${c.solveTime}min avg"></div>`;
      }).join('');
    }

    function filterChallenges(q) { renderChallenges(q); }
    function filterLeaderboard(q) { renderLeaderboard(q); }

    // Init
    renderChallenges();
    renderLeaderboard();
    renderCharts();
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Challenges — CTF">
  <main class="mx-auto max-w-6xl px-6 py-8">
    {/* Header */}
    <header class="mb-8 animate-fade-in-up">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-accent">Mission Control</p>
          <h1 class="mt-2 text-3xl font-bold text-text-primary" style="font-family: 'JetBrains Mono', monospace;">
            Challenge Grid
          </h1>
        </div>
        <div class="flex items-center gap-4">
          <div class="rounded-lg px-4 py-2 text-sm font-medium" style="background: var(--accent-dim); color: var(--accent);">
            <span class="mr-2">⏱</span>
            <span id="countdown">02:45:30</span>
          </div>
          <div class="rounded-lg px-4 py-2 text-sm font-medium" style="background: var(--surface); color: var(--text-muted); border: 1px solid var(--border);">
            <span class="mr-2">🏆</span>
            Rank #12
          </div>
        </div>
      </div>
    </header>

    {/* Category Filters */}
    <div class="mb-6 flex gap-2 animate-fade-in-up" style="animation-delay: 100ms;">
      <button class="rounded-lg px-4 py-2 text-sm font-medium transition" style="background: var(--accent); color: var(--background);">
        All
      </button>
      <button class="rounded-lg px-4 py-2 text-sm font-medium transition" style="background: var(--surface); color: var(--text-muted); border: 1px solid var(--border);">
        Crypto
      </button>
      <button class="rounded-lg px-4 py-2 text-sm font-medium transition" style="background: var(--surface); color: var(--text-muted); border: 1px solid var(--border);">
        Web
      </button>
      <button class="rounded-lg px-4 py-2 text-sm font-medium transition" style="background: var(--surface); color: var(--text-muted); border: 1px solid var(--border);">
        Pwn
      </button>
      <button class="rounded-lg px-4 py-2 text-sm font-medium transition" style="background: var(--surface); color: var(--text-muted); border: 1px solid var(--border);">
        Forensics
      </button>
      <button class="rounded-lg px-4 py-2 text-sm font-medium transition" style="background: var(--surface); color: var(--text-muted); border: 1px solid var(--border);">
        Reverse
      </button>
    </div>

    {/* Challenge Grid */}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 animate-fade-in-up" style="animation-delay: 200ms;">
      {/* Challenge 1 — Active */}
      <div class="card-hover rounded-xl p-5" style="background: var(--surface); border: 1px solid var(--border);">
        <div class="mb-3 flex items-center justify-between">
          <span class="rounded px-2 py-1 text-xs font-bold uppercase" style="background: var(--accent-dim); color: var(--accent);">
            Crypto
          </span>
          <span class="text-xs font-medium" style="color: var(--text-dim);">
            100 pts
          </span>
        </div>
        <h3 class="mb-2 text-lg font-bold text-text-primary" style="font-family: 'JetBrains Mono', monospace;">
          Caesar's Secrets
        </h3>
        <p class="mb-4 text-sm" style="color: var(--text-muted);">
          Decrypt the message using a modified Caesar cipher with a twist.
        </p>
        <div class="flex items-center justify-between">
          <span class="rounded px-2 py-1 text-xs font-medium" style="background: var(--accent-dim); color: var(--accent);">
            ● Active
          </span>
          <span class="text-xs" style="color: var(--text-dim);">
            23 solves
          </span>
        </div>
      </div>

      {/* Challenge 2 — Active */}
      <div class="card-hover rounded-xl p-5" style="background: var(--surface); border: 1px solid var(--border);">
        <div class="mb-3 flex items-center justify-between">
          <span class="rounded px-2 py-1 text-xs font-bold uppercase" style="background: rgba(90, 138, 204, 0.12); color: var(--info);">
            Web
          </span>
          <span class="text-xs font-medium" style="color: var(--text-dim);">
            200 pts
          </span>
        </div>
        <h3 class="mb-2 text-lg font-bold text-text-primary" style="font-family: 'JetBrains Mono', monospace;">
          SQL Injection 101
        </h3>
        <p class="mb-4 text-sm" style="color: var(--text-muted);">
          Find the vulnerability in the login form and extract the flag.
        </p>
        <div class="flex items-center justify-between">
          <span class="rounded px-2 py-1 text-xs font-medium" style="background: var(--accent-dim); color: var(--accent);">
            ● Active
          </span>
          <span class="text-xs" style="color: var(--text-dim);">
            45 solves
          </span>
        </div>
      </div>

      {/* Challenge 3 — Locked */}
      <div class="card-hover rounded-xl p-5 opacity-60" style="background: var(--surface); border: 1px solid var(--border);">
        <div class="mb-3 flex items-center justify-between">
          <span class="rounded px-2 py-1 text-xs font-bold uppercase" style="background: rgba(204, 90, 90, 0.12); color: var(--danger);">
            Pwn
          </span>
          <span class="text-xs font-medium" style="color: var(--text-dim);">
            300 pts
          </span>
        </div>
        <h3 class="mb-2 text-lg font-bold text-text-primary" style="font-family: 'JetBrains Mono', monospace;">
          Buffer Overflow
        </h3>
        <p class="mb-4 text-sm" style="color: var(--text-muted);">
          Exploit the binary to gain control of the execution flow.
        </p>
        <div class="flex items-center justify-between">
          <span class="rounded px-2 py-1 text-xs font-medium" style="background: rgba(204, 184, 90, 0.12); color: var(--warning);">
            🔒 Locked
          </span>
          <span class="text-xs" style="color: var(--text-dim);">
            Unlocks in 1h
          </span>
        </div>
      </div>

      {/* Challenge 4 — Completed */}
      <div class="card-hover rounded-xl p-5" style="background: var(--surface); border: 1px solid var(--accent);">
        <div class="mb-3 flex items-center justify-between">
          <span class="rounded px-2 py-1 text-xs font-bold uppercase" style="background: rgba(204, 184, 90, 0.12); color: var(--warning);">
            Forensics
          </span>
          <span class="text-xs font-medium" style="color: var(--text-dim);">
            150 pts
          </span>
        </div>
        <h3 class="mb-2 text-lg font-bold text-text-primary" style="font-family: 'JetBrains Mono', monospace;">
          Hidden in Plain Sight
        </h3>
        <p class="mb-4 text-sm" style="color: var(--text-muted);">
          Analyze the image file to find the concealed message.
        </p>
        <div class="flex items-center justify-between">
          <span class="rounded px-2 py-1 text-xs font-medium" style="background: var(--accent-dim); color: var(--accent);">
            ✓ Completed
          </span>
          <span class="text-xs" style="color: var(--text-dim);">
            67 solves
          </span>
        </div>
      </div>

      {/* Challenge 5 — Active */}
      <div class="card-hover rounded-xl p-5" style="background: var(--surface); border: 1px solid var(--border);">
        <div class="mb-3 flex items-center justify-between">
          <span class="rounded px-2 py-1 text-xs font-bold uppercase" style="background: rgba(204, 90, 90, 0.12); color: var(--danger);">
            Reverse
          </span>
          <span class="text-xs font-medium" style="color: var(--text-dim);">
            250 pts
          </span>
        </div>
        <h3 class="mb-2 text-lg font-bold text-text-primary" style="font-family: 'JetBrains Mono', monospace;">
          Binary Beauties
        </h3>
        <p class="mb-4 text-sm" style="color: var(--text-muted);">
          Reverse engineer the binary to understand its encryption algorithm.
        </p>
        <div class="flex items-center justify-between">
          <span class="rounded px-2 py-1 text-xs font-medium" style="background: var(--accent-dim); color: var(--accent);">
            ● Active
          </span>
          <span class="text-xs" style="color: var(--text-dim);">
            12 solves
          </span>
        </div>
      </div>

      {/* Challenge 6 — Active */}
      <div class="card-hover rounded-xl p-5" style="background: var(--surface); border: 1px solid var(--border);">
        <div class="mb-3 flex items-center justify-between">
          <span class="rounded px-2 py-1 text-xs font-bold uppercase" style="background: rgba(90, 138, 204, 0.12); color: var(--info);">
            Web
          </span>
          <span class="text-xs font-medium" style="color: var(--text-dim);">
            175 pts
          </span>
        </div>
        <h3 class="mb-2 text-lg font-bold text-text-primary" style="font-family: 'JetBrains Mono', monospace;">
          XSS Playground
        </h3>
        <p class="mb-4 text-sm" style="color: var(--text-muted);">
          Craft a cross-site scripting payload to steal the admin cookie.
        </p>
        <div class="flex items-center justify-between">
          <span class="rounded px-2 py-1 text-xs font-medium" style="background: var(--accent-dim); color: var(--accent);">
            ● Active
          </span>
          <span class="text-xs" style="color: var(--text-dim);">
            38 solves
          </span>
        </div>
      </div>
    </div>

    {/* Leaderboard Preview */}
    <section class="mt-12 animate-fade-in-up" style="animation-delay: 300ms;">
      <h2 class="mb-4 text-xl font-bold text-text-primary" style="font-family: 'JetBrains Mono', monospace;">
        Leaderboard
      </h2>
      <div class="rounded-xl overflow-hidden" style="background: var(--surface); border: 1px solid var(--border);">
        <table class="w-full text-sm">
          <thead>
            <tr style="background: var(--surface-2);">
              <th class="px-4 py-3 text-left font-medium" style="color: var(--text-muted);">Rank</th>
              <th class="px-4 py-3 text-left font-medium" style="color: var(--text-muted);">Team</th>
              <th class="px-4 py-3 text-right font-medium" style="color: var(--text-muted);">Score</th>
              <th class="px-4 py-3 text-right font-medium" style="color: var(--text-muted);">Solves</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-top: 1px solid var(--border);">
              <td class="px-4 py-3 font-bold" style="color: var(--accent);">1</td>
              <td class="px-4 py-3 font-medium text-text-primary">Phantom Hackers</td>
              <td class="px-4 py-3 text-right font-mono" style="color: var(--accent);">2,450</td>
              <td class="px-4 py-3 text-right" style="color: var(--text-muted);">18</td>
            </tr>
            <tr style="border-top: 1px solid var(--border);">
              <td class="px-4 py-3 font-bold" style="color: var(--text-muted);">2</td>
              <td class="px-4 py-3 font-medium text-text-primary">Cyber Wolves</td>
              <td class="px-4 py-3 text-right font-mono" style="color: var(--text-muted);">2,100</td>
              <td class="px-4 py-3 text-right" style="color: var(--text-muted);">15</td>
            </tr>
            <tr style="border-top: 1px solid var(--border);">
              <td class="px-4 py-3 font-bold" style="color: var(--warning);">3</td>
              <td class="px-4 py-3 font-medium text-text-primary">Binary Bandits</td>
              <td class="px-4 py-3 text-right font-mono" style="color: var(--text-muted);">1,850</td>
              <td class="px-4 py-3 text-right" style="color: var(--text-muted);">12</td>
            </tr>
            <tr style="border-top: 1px solid var(--border);">
              <td class="px-4 py-3 font-bold" style="color: var(--text-dim);">12</td>
              <td class="px-4 py-3 font-medium text-text-primary" style="color: var(--accent);">You</td>
              <td class="px-4 py-3 text-right font-mono" style="color: var(--accent);">450</td>
              <td class="px-4 py-3 text-right" style="color: var(--text-muted);">3</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    // Countdown timer
    function updateCountdown() {
      const el = document.getElementById('countdown');
      if (!el) return;
      
      // Set end time to 2h 45m 30s from now (for demo)
      const now = new Date();
      const end = new Date(now.getTime() + (2 * 60 * 60 + 45 * 60 + 30) * 1000);
      
      function tick() {
        const diff = end.getTime() - Date.now();
        if (diff <= 0) {
          el.textContent = '00:00:00';
          return;
        }
        const h = Math.floor(diff / (1000 * 60 * 60));
        const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((diff % (1000 * 60)) / 1000);
        el.textContent = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        requestAnimationFrame(tick);
      }
      tick();
    }
    updateCountdown();
  </script>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { createDb } from '../../lib/db/client';
import { getEnv } from '../../lib/runtime';
import { ensureCurrentEventState } from '../../lib/event/state';
import { getEventTiming } from '../../lib/event/timer';
import { and, eq } from 'drizzle-orm';
import { challenges, solves } from '../../lib/db/schema';
import { getChallengeBySlot } from '../../lib/challenges';
import { CASEBOOK } from '../../../challenges/shared/casebook';
import { getCodename } from '../../../challenges/shared/codenames';

export const prerender = false;

const slug = Astro.params.event!;
const auth = Astro.locals.auth;

// Protected: unauthenticated (or wrong-event) requests redirect to login.
if (!auth || auth.event.slug !== slug) {
	return Astro.redirect(`/${slug}/login`);
}

// Canonical lazy expiry refresh, then derive authoritative timing.
const db = createDb(getEnv().DB);
const now = new Date();
const event = await ensureCurrentEventState(db, auth.event, now);
const timing = getEventTiming(event, now);

const roll = auth.participant.rollNumber;
const codename = getCodename(roll);
const current = auth.participant.currentChallenge;

// The casebook: one log entry per solved slot, in case order.
const solvedSlots = (
	await db
		.select({ slot: challenges.slot })
		.from(solves)
		.innerJoin(challenges, eq(solves.challengeId, challenges.id))
		.where(and(eq(solves.participantId, auth.participant.id), eq(solves.eventId, event.id)))
		.all()
).map((r) => r.slot).sort((a, b) => a - b);
const solvedSet = new Set(solvedSlots);
const completed = solvedSet.has(30);
const entries = solvedSlots.map((slot) => ({ slot, title: getChallengeBySlot(slot)?.metadata.title ?? '', text: CASEBOOK[slot] }));
const lead = getChallengeBySlot(current)?.metadata.title ?? '';

function fmt(seconds: number): string {
	const s = Math.max(0, seconds);
	const h = Math.floor(s / 3600);
	const m = Math.floor((s % 3600) / 60);
	const sec = s % 60;
	return [h, m, sec].map((n) => String(n).padStart(2, '0')).join(':');
}

type View = 'waiting' | 'live' | 'ended' | 'review' | 'results' | 'archived';
let view: View;
if (timing.isLive) view = 'live';
else if (event.state === 'READY' || event.state === 'DRAFT') view = 'waiting';
else if (event.state === 'REVIEW') view = 'review';
else if (event.state === 'RESULTS_PUBLISHED') view = 'results';
else if (event.state === 'ARCHIVED') view = 'archived';
else view = 'ended'; // FROZEN or expired-LIVE
---

<Layout title={`${event.name} — ${event.state}`}>
	<main class={view === 'live' ? 'mx-auto flex min-h-screen w-full max-w-2xl flex-col gap-4 px-6 py-10' : 'mx-auto flex min-h-screen w-full max-w-md flex-col justify-center gap-4 px-6'}>
		<div class="flex items-center justify-between">
			<p class="text-xs uppercase tracking-[0.3em] text-emerald-400">{event.name}</p>
			<form method="POST" action="/api/auth/logout">
				<input type="hidden" name="redirect" value={`/${slug}/login`} />
				<button type="submit" class="text-xs text-neutral-500 hover:text-neutral-300">Log out</button>
			</form>
		</div>

		{view === 'waiting' && (
			<div class="flex flex-col gap-3">
				<h1 class="text-2xl font-semibold">Waiting room</h1>
				<p class="text-neutral-400">The competition has not started yet. This page updates on refresh.</p>
				<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
					<dt class="text-neutral-400">Investigator</dt><dd>{roll}</dd>
					<dt class="text-neutral-400">State</dt><dd>{event.state}</dd>
					<dt class="text-neutral-400">Duration</dt><dd>{fmt(timing.durationSeconds)}</dd>
				</dl>
			</div>
		)}

		{view === 'live' && (
			<div class="flex flex-col gap-6" data-live-timer data-ends-at={timing.endsAt} data-server-now={timing.serverNow}>
				<header class="flex items-end justify-between border-b border-neutral-800 pb-4">
					<div>
						<p class="font-mono text-[10px] tracking-[0.3em] text-neutral-600 uppercase">{current >= 30 ? 'The Continuity' : 'Blackwood Investigative Bureau'} · Case 71-C</p>
						<h1 class="mt-1 text-2xl font-semibold">{completed ? 'Case 71-C is closed.' : 'The investigation is open.'}</h1>
					</div>
					<p class="text-right font-mono text-[10px] text-neutral-600">INV-{roll}<br /><span class="text-neutral-700">{codename}</span></p>
				</header>

				{completed ? (
					<pre class="rounded border border-neutral-700 bg-black px-6 py-6 font-mono text-sm leading-relaxed text-neutral-100">{[
						'SUBJECT IDENTIFIED.',
						'LEDGER UPDATED.',
						'CASE 71-C CLOSED.',
						'CONTINUITY STATUS: ACTIVE.',
						'',
						`WELCOME, ${codename}.`,
					].join('\n')}</pre>
				) : (
					<div class="flex flex-wrap items-center justify-between gap-4 rounded border border-neutral-800 bg-neutral-900/60 px-5 py-4">
						<div>
							<p class="font-mono text-[10px] tracking-[0.2em] text-neutral-600 uppercase">Current lead · Q{String(current).padStart(2, '0')} / 30</p>
							<p class="mt-1 text-lg text-neutral-100">{lead}</p>
						</div>
						<a href={`/${slug}/challenge/${current}`} class="rounded bg-emerald-500 px-4 py-2 text-sm font-semibold text-neutral-950 hover:bg-emerald-400">
							Go to challenge {current} →
						</a>
					</div>
				)}

				<div class="flex items-center justify-between gap-4">
					<p class="font-mono text-4xl tabular-nums" data-remaining>{fmt(timing.remainingSeconds)}</p>
					<p class="text-right font-mono text-[10px] leading-relaxed text-neutral-600">remaining<br />server time is authoritative</p>
				</div>

				<ol class="grid grid-cols-10 gap-1" aria-label="Case files">
					{Array.from({ length: 30 }, (_, i) => i + 1).map((n) => (
						<li title={`Q${n}`} class={`h-2 rounded-sm ${solvedSet.has(n) ? 'bg-emerald-500/70' : n === current ? 'bg-neutral-500 animate-pulse' : 'bg-neutral-800'}`}></li>
					))}
				</ol>

				<section aria-label="Casebook">
					<p class="mb-3 font-mono text-[10px] tracking-[0.3em] text-neutral-600 uppercase">Casebook — {entries.length} of 30 filed</p>
					{entries.length === 0 ? (
						<p class="text-sm text-neutral-500">Nothing filed yet. The first lead is waiting.</p>
					) : (
						<ol class="space-y-3">
							{entries.map((e) => (
								<li class="border-l border-neutral-800 pl-4">
									<a href={`/${slug}/challenge/${e.slot}`} class="font-mono text-[10px] tracking-[0.15em] text-neutral-500 uppercase hover:text-neutral-300">Q{String(e.slot).padStart(2, '0')} · {e.title}</a>
									<p class="mt-0.5 text-sm leading-relaxed text-neutral-300">{e.text}</p>
								</li>
							))}
						</ol>
					)}
				</section>
			</div>
		)}

		{(view === 'ended' || view === 'review') && (
			<div class="flex flex-col gap-3">
				<h1 class="text-2xl font-semibold">Competition ended.</h1>
				<p class="text-neutral-400">
					{view === 'review'
						? 'Results are under review.'
						: 'Submissions are closed. Results are not published yet.'}
				</p>
				<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
					<dt class="text-neutral-400">Investigator</dt><dd>{roll}</dd>
					<dt class="text-neutral-400">State</dt><dd>{event.state}</dd>
				</dl>
			</div>
		)}

		{view === 'results' && (
			<div class="flex flex-col gap-3">
				<h1 class="text-2xl font-semibold">Results published.</h1>
				<p class="text-neutral-400">Final standings are available.</p>
			</div>
		)}

		{view === 'archived' && (
			<div class="flex flex-col gap-3">
				<h1 class="text-2xl font-semibold">Event archived.</h1>
				<p class="text-neutral-400">This investigation is closed.</p>
			</div>
		)}
	</main>

	<div data-toasts class="fixed bottom-4 right-4 flex flex-col gap-2"></div>
</Layout>

<script>
	import { startLiveFeed } from '../../scripts/live-feed';
	import { renderStreak } from '../../scripts/streak';
	startLiveFeed({ onStateChange: () => location.reload() });
	renderStreak(location.pathname.split('/')[1]);
</script>

<script>
	// Display-only countdown. Server timing is authoritative; a refresh resyncs.
	const el = document.querySelector<HTMLElement>('[data-live-timer]');
	const out = el?.querySelector<HTMLElement>('[data-remaining]');
	if (el && out) {
		const endsAt = Number(el.dataset.endsAt);
		const serverNow = Number(el.dataset.serverNow);
		const clientStart = Date.now();
		const tick = () => {
			const elapsed = Math.floor((Date.now() - clientStart) / 1000);
			let rem = endsAt - (serverNow + elapsed);
			if (rem < 0) rem = 0;
			const h = Math.floor(rem / 3600);
			const m = Math.floor((rem % 3600) / 60);
			const s = rem % 60;
			out.textContent = [h, m, s].map((n) => String(n).padStart(2, '0')).join(':');
			if (rem === 0) clearInterval(timer);
		};
		const timer = setInterval(tick, 1000);
		tick();
	}
</script>

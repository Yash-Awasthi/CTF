---
import Layout from '../../layouts/Layout.astro';
import { createDb } from '../../lib/db/client';
import { getEnv } from '../../lib/runtime';
import { ensureCurrentEventState } from '../../lib/event/state';
import { getEventTiming } from '../../lib/event/timer';

export const prerender = false;

const slug = Astro.params.event!;
const auth = Astro.locals.auth;

// Protected: unauthenticated (or wrong-event) requests redirect to login.
if (!auth || auth.event.slug !== slug) {
	return Astro.redirect(`/${slug}/login`);
}

// Canonical lazy expiry refresh, then derive authoritative timing.
const db = createDb(getEnv().DB);
const now = new Date();
const event = await ensureCurrentEventState(db, auth.event, now);
const timing = getEventTiming(event, now);

const roll = auth.participant.rollNumber;

function fmt(seconds: number): string {
	const s = Math.max(0, seconds);
	const h = Math.floor(s / 3600);
	const m = Math.floor((s % 3600) / 60);
	const sec = s % 60;
	return [h, m, sec].map((n) => String(n).padStart(2, '0')).join(':');
}

type View = 'waiting' | 'live' | 'ended' | 'review' | 'results' | 'archived';
let view: View;
if (timing.isLive) view = 'live';
else if (event.state === 'READY' || event.state === 'DRAFT') view = 'waiting';
else if (event.state === 'REVIEW') view = 'review';
else if (event.state === 'RESULTS_PUBLISHED') view = 'results';
else if (event.state === 'ARCHIVED') view = 'archived';
else view = 'ended'; // FROZEN or expired-LIVE
---

<Layout title={`${event.name} — ${event.state}`}>
	<main class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center gap-4 px-6">
		<div class="flex items-center justify-between">
			<p class="text-xs uppercase tracking-[0.3em] text-emerald-400">{event.name}</p>
			<form method="POST" action="/api/auth/logout">
				<input type="hidden" name="redirect" value={`/${slug}/login`} />
				<button type="submit" class="text-xs text-neutral-500 hover:text-neutral-300">Log out</button>
			</form>
		</div>

		{view === 'waiting' && (
			<div class="flex flex-col gap-3">
				<h1 class="text-2xl font-semibold">Waiting room</h1>
				<p class="text-neutral-400">The competition has not started yet. This page updates on refresh.</p>
				<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
					<dt class="text-neutral-400">Investigator</dt><dd>{roll}</dd>
					<dt class="text-neutral-400">State</dt><dd>{event.state}</dd>
					<dt class="text-neutral-400">Duration</dt><dd>{fmt(timing.durationSeconds)}</dd>
				</dl>
			</div>
		)}

		{view === 'live' && (
			<div
				class="flex flex-col gap-3"
				data-live-timer
				data-ends-at={timing.endsAt}
				data-server-now={timing.serverNow}
			>
				<h1 class="text-2xl font-semibold">Competition is live.</h1>
				<p class="text-5xl font-mono tabular-nums" data-remaining>{fmt(timing.remainingSeconds)}</p>
				<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm text-neutral-400">
					<dt>Investigator</dt><dd class="text-neutral-100">{roll}</dd>
					<dt>State</dt><dd class="text-neutral-100">{event.state}</dd>
					<dt>Started</dt><dd class="text-neutral-100">{new Date((timing.startedAt ?? 0) * 1000).toUTCString()}</dd>
					<dt>Ends</dt><dd class="text-neutral-100">{new Date((timing.endsAt ?? 0) * 1000).toUTCString()}</dd>
				</dl>
				<a
					href={`/${slug}/challenge/${auth.participant.currentChallenge}`}
					class="inline-block rounded bg-emerald-500 px-4 py-2 text-center text-sm font-semibold text-neutral-950 hover:bg-emerald-400"
				>
					Go to challenge {auth.participant.currentChallenge} →
				</a>
				<p class="text-xs text-neutral-500">Timer is display-only; the server is authoritative. Refresh to resync.</p>
			</div>
		)}

		{(view === 'ended' || view === 'review') && (
			<div class="flex flex-col gap-3">
				<h1 class="text-2xl font-semibold">Competition ended.</h1>
				<p class="text-neutral-400">
					{view === 'review'
						? 'Results are under review.'
						: 'Submissions are closed. Results are not published yet.'}
				</p>
				<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
					<dt class="text-neutral-400">Investigator</dt><dd>{roll}</dd>
					<dt class="text-neutral-400">State</dt><dd>{event.state}</dd>
				</dl>
			</div>
		)}

		{view === 'results' && (
			<div class="flex flex-col gap-3">
				<h1 class="text-2xl font-semibold">Results published.</h1>
				<p class="text-neutral-400">Final standings are available.</p>
			</div>
		)}

		{view === 'archived' && (
			<div class="flex flex-col gap-3">
				<h1 class="text-2xl font-semibold">Event archived.</h1>
				<p class="text-neutral-400">This investigation is closed.</p>
			</div>
		)}
	</main>

	<div data-toasts class="fixed bottom-4 right-4 flex flex-col gap-2"></div>
</Layout>

<script>
	// Live updates (Phase 12): SSE with a polling fallback. State/timer changes
	// trigger a resync (reload); first-blood + announcements show a toast. The
	// countdown itself is NOT streamed — it's computed locally below.
	(() => {
		const toasts = document.querySelector<HTMLElement>('[data-toasts]');
		function toast(msg: string) {
			if (!toasts) return;
			const d = document.createElement('div');
			d.className = 'rounded bg-neutral-800 px-4 py-2 text-sm text-emerald-300 shadow';
			d.textContent = msg;
			toasts.appendChild(d);
			setTimeout(() => d.remove(), 8000);
		}
		let cursors = { fb: 0, ann: 0 };
		let stateVersion: string | null = null;
		const seen = new Set<string>();

		function handleSnapshot(snap: any) {
			if (stateVersion === null) stateVersion = snap.stateVersion;
			else if (snap.stateVersion !== stateVersion) { location.reload(); return; }
			for (const fb of snap.firstBloods ?? []) {
				if (!seen.has('fb' + fb.id)) { seen.add('fb' + fb.id); toast(fb.message); }
			}
			for (const a of snap.announcements ?? []) {
				if (!seen.has('an' + a.id)) { seen.add('an' + a.id); toast('📢 ' + a.message); }
			}
			if (snap.cursors) cursors = snap.cursors;
		}

		if (typeof EventSource !== 'undefined') {
			const connect = () => {
				const es = new EventSource(`/api/events/stream?fb=${cursors.fb}&ann=${cursors.ann}`);
				es.addEventListener('state', (e) => {
					const d = JSON.parse((e as MessageEvent).data);
					if (stateVersion === null) stateVersion = d.stateVersion;
					else if (d.stateVersion !== stateVersion) location.reload();
				});
				es.addEventListener('firstblood', (e) => {
					const d = JSON.parse((e as MessageEvent).data);
					const id = (e as MessageEvent).lastEventId;
					if (!seen.has('fb' + id)) { seen.add('fb' + id); cursors.fb = Number(id) || cursors.fb; toast(d.message); }
				});
				es.addEventListener('announcement', (e) => {
					const d = JSON.parse((e as MessageEvent).data);
					const id = (e as MessageEvent).lastEventId;
					if (!seen.has('an' + id)) { seen.add('an' + id); cursors.ann = Number(id) || cursors.ann; toast('📢 ' + d.message); }
				});
				es.onerror = () => { es.close(); setTimeout(connect, 3000); };
			};
			connect();
		} else {
			// Fallback: lightweight polling of authoritative D1 snapshots.
			setInterval(async () => {
				try {
					const res = await fetch(`/api/events/updates?fb=${cursors.fb}&ann=${cursors.ann}`);
					if (res.ok) handleSnapshot(await res.json());
				} catch { /* offline — D1 remains source of truth on next tick */ }
			}, 6000);
		}
	})();
</script>

<script>
	// Display-only countdown. Server timing is authoritative; a refresh resyncs.
	const el = document.querySelector<HTMLElement>('[data-live-timer]');
	const out = el?.querySelector<HTMLElement>('[data-remaining]');
	if (el && out) {
		const endsAt = Number(el.dataset.endsAt);
		const serverNow = Number(el.dataset.serverNow);
		const clientStart = Date.now();
		const tick = () => {
			const elapsed = Math.floor((Date.now() - clientStart) / 1000);
			let rem = endsAt - (serverNow + elapsed);
			if (rem < 0) rem = 0;
			const h = Math.floor(rem / 3600);
			const m = Math.floor((rem % 3600) / 60);
			const s = rem % 60;
			out.textContent = [h, m, s].map((n) => String(n).padStart(2, '0')).join(':');
			if (rem === 0) clearInterval(timer);
		};
		const timer = setInterval(tick, 1000);
		tick();
	}
</script>

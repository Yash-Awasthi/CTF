								class="font-mono text-[10px] tracking-[0.1em] text-neutral-700 uppercase transition-colors hover:text-neutral-500">
								Request {isQ30 ? 'case note' : 'terminal note'} {nextHint}<span class="ml-1 text-neutral-800">— halves score</span>
							</button>
						)}
						<div>
							<p class="mb-2 font-mono text-[9px] tracking-[0.2em] text-neutral-700 uppercase">
								{isQ30 ? 'Response' : 'Terminal Input'}
							</p>
							<form data-submit-form
								data-msg-verifying={qm.msgVerifying}
								data-msg-correct={qm.msgCorrect}
								data-msg-incorrect={qm.msgIncorrect}
								data-msg-error="System error. Please try again."
								data-btn-loading="Processing…"
							>
								<div class="flex gap-2">
									<input type="text" name="answer" autocomplete="off" spellcheck="false"
										placeholder={qm.placeholder} aria-label={qm.placeholder}
										class={`flex-1 rounded border bg-black px-3 py-2 font-mono text-sm placeholder-neutral-800 transition-colors focus:outline-none ${isQ30 ? 'border-neutral-600 text-neutral-100 focus:border-neutral-400' : 'border-neutral-700 text-neutral-200 focus:border-neutral-600'}`}/>
									<button type="submit"
										class={`rounded border px-4 py-2 font-mono text-[10px] tracking-[0.15em] uppercase transition-colors ${isQ30 ? 'border-neutral-500 bg-neutral-800 text-neutral-300 hover:border-neutral-300 hover:bg-neutral-700 hover:text-neutral-100' : 'border-neutral-700 bg-neutral-900 text-neutral-400 hover:border-neutral-600 hover:bg-neutral-800 hover:text-neutral-200'}`}>
										{isQ30 ? 'Submit' : 'Enter'}
									</button>
								</div>
								<p class="mt-2 min-h-[1rem] font-mono text-[10px] text-neutral-700" data-result aria-live="polite"></p>
							</form>
						</div>
					</div>
				)}

			</div>
			<div class="mt-5 flex items-center justify-between font-mono text-[10px] text-neutral-800">
				<span>THE CONTINUITY</span>
				<span>FILE 71-C</span>
			</div>
		</main>
	)}

	<!-- ══════════════════════════════════════════════════════════════════════ -->
	<!-- Q10 ONLY — STANDARD DOSSIER CARD                                    -->
	<!-- ══════════════════════════════════════════════════════════════════════ -->

	{!isQ1 && !isQ2 && !isQ3 && !isQ4 && !isQ5 && !isQ6 && !isQ7 && !isQ8 && !isQ9 && gp && (
		<main
			class="mx-auto w-full max-w-3xl px-4 py-10"
			data-challenge
			data-slug={slug}
			data-slot={view.slot}
		>
			<article class="overflow-hidden rounded-lg border border-neutral-800 bg-neutral-900/80 shadow-xl">

				<!-- Header: tier badge + title + slot ring -->
				<header class="flex items-start justify-between border-b border-neutral-800 bg-neutral-900 px-6 py-5">
					<div class="flex flex-col gap-2">
						<div class="flex items-center gap-2.5">
							<span class={`rounded border px-2 py-0.5 font-mono text-[10px] tracking-[0.15em] ${ts.badge}`}>
								{view.tier.toUpperCase()}
							</span>
							<span class="font-mono text-[10px] text-neutral-600 tracking-widest">{view.basePoints} PTS</span>
						</div>
						<div>
							<p class="mb-0.5 font-mono text-[10px] tracking-[0.3em] text-neutral-700">CHALLENGE {slotLabel}</p>
							<h1 class="text-xl font-semibold tracking-tight text-neutral-100">{view.title}</h1>
						</div>
					</div>

					<!-- Circular slot indicator -->
					<div class="relative flex h-14 w-14 shrink-0 items-center justify-center">
						<svg class="absolute inset-0 h-14 w-14 -rotate-90" viewBox="0 0 56 56" aria-hidden="true">
							<circle cx="28" cy="28" r="24" fill="none" stroke="rgb(38 38 38)" stroke-width="1.5"/>
							<circle cx="28" cy="28" r="24" fill="none" stroke="rgb(82 82 82 / 0.6)" stroke-width="1.5"
								stroke-dasharray={`${progressPct * 1.508} 150.8`} stroke-linecap="round"/>
						</svg>
						<span class="relative font-mono text-sm font-semibold text-neutral-400">{view.slot}</span>
					</div>
				</header>

				<!-- Meta strip -->
				<div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-b border-neutral-800 bg-neutral-950/40 px-6 py-3">
					<div class="flex items-center gap-2 font-mono text-[10px]">
						<span class="text-neutral-700">STATUS</span>
						<span data-status class={isSolved ? 'text-neutral-500' : 'text-neutral-600'}>
							{isSolved ? 'SOLVED' : 'ACTIVE'}
						</span>
					</div>
					<div class="flex items-center gap-2 font-mono text-[10px]">
						<span class="text-neutral-700">TOKEN</span>
						<span class="tracking-widest text-neutral-700">{gp.token}</span>
					</div>
				</div>

				<!-- Briefing block -->
				<div class="px-6 py-6">
					<p class="mb-3 font-mono text-[10px] tracking-[0.3em] text-neutral-700 uppercase">Briefing</p>
					<div class="rounded border border-neutral-800 bg-neutral-950/60 p-5">
						<pre class="whitespace-pre-wrap font-mono text-sm leading-relaxed text-neutral-300">{gp.prompt}</pre>
					</div>
				</div>

				<!-- Solved banner -->
				{isSolved && (
					<div class="mx-6 mb-5 rounded border border-neutral-800/50 bg-neutral-900/60 px-4 py-3">
						<p class="font-mono text-[10px] text-neutral-600">Finding submitted. This challenge can no longer be scored.</p>
					</div>
				)}

				<!-- Hints section -->
				<section class="border-t border-neutral-800 px-6 py-5" data-hints aria-label="Field assistance">
					<p class="mb-3 font-mono text-[10px] tracking-[0.3em] text-neutral-700 uppercase">Field Assistance</p>
					<ul class="mb-3 space-y-2" data-hint-list>
						{revealedHints.map((h) => (
							<li class="flex gap-3 rounded border border-neutral-800 bg-neutral-950/60 px-4 py-3" data-hint-number={h.hintNumber}>
								<span class="mt-0.5 shrink-0 font-mono text-[10px] text-neutral-600 uppercase">H{h.hintNumber}</span>
								<span class="text-sm text-neutral-400 leading-relaxed">{h.text}</span>
							</li>
						))}
					</ul>
					{isCurrent && nextHint <= MAX_HINTS && (
						<button type="button" data-hint-button data-next-hint={nextHint}
							class="font-mono text-[10px] tracking-[0.1em] text-neutral-700 uppercase transition-colors hover:text-neutral-500">
							Request hint {nextHint}
							<span class="ml-1 text-neutral-800">— halves this challenge's score</span>
						</button>
					)}
				</section>

				<!-- Submit section -->
				{isCurrent && (
					<div class="border-t border-neutral-800 px-6 py-6">
						<p class="mb-3 font-mono text-[10px] tracking-[0.3em] text-neutral-700 uppercase">Submit Finding</p>
						<form data-submit-form>
							<div class="flex gap-3">
								<input type="text" name="answer" autocomplete="off" spellcheck="false"
									placeholder="Enter your answer…" aria-label="Your answer"
									class="flex-1 rounded border border-neutral-700 bg-neutral-950 px-4 py-2.5 text-sm text-neutral-200 placeholder-neutral-700 transition-colors focus:border-neutral-500 focus:outline-none"/>
								<button type="submit"
									class="rounded border border-neutral-700 bg-neutral-800 px-6 py-2.5 text-sm font-medium text-neutral-300 transition-colors hover:border-neutral-600 hover:bg-neutral-700 hover:text-neutral-100">
									Submit
								</button>
							</div>
							<p class="mt-3 min-h-[1.25rem] font-mono text-[10px] text-neutral-600" data-result aria-live="polite"></p>
						</form>
					</div>
				)}

			</article>

			<div class="mt-6 flex items-center justify-between font-mono text-[10px] text-neutral-800">
				<span>BLACKWOOD INVESTIGATIVE BUREAU</span>
				<span>FILE 71-C · {new Date().getFullYear()}</span>
			</div>
		</main>
	)}

</div>
{isQ18 && (
	<script>
		(function() {
			const btn = document.getElementById('q18-play-btn');
			const status = document.getElementById('q18-status');
			if (!btn || !status) return;
			if (!window.speechSynthesis) {
				status.textContent = 'TTS not supported in this browser.';
				return;
			}
			btn.addEventListener('click', function() {
				window.speechSynthesis.cancel();
				const phrase = atob(btn.dataset.b64 || '');
				if (!phrase) return;
				const utt = new SpeechSynthesisUtterance(phrase);
				utt.rate = 0.82;
				utt.pitch = 0.95;
				utt.onstart = function() {
					btn.textContent = '\u23F8 Playing…';
					status.textContent = 'Recording active…';
				};
				utt.onend = function() {
					btn.textContent = '\u25B6 Play voicemail';
					status.textContent = 'Playback complete.';
				};
				window.speechSynthesis.speak(utt);
			});
		})();
	</script>
)}

</Layout>
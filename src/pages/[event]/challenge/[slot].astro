---
/**
 * Challenge page — serves Q1–Q30.
 *
 * Q1 ("the-assignment"):   institutional memo layout — participant confirms
 *   their codename to accept the case assignment.
 *
 * Q2 ("eleven-years-cold"): institutional case-file layout — Mira Castellan's
 *   official disappearance record. An evidence item is suppressed from the
 *   rendered view but referenced in an auto-generated HTML comment. Technique:
 *   View Source / DevTools inspection.
 *
 * Q3–Q30: standard dossier card — case-file header, briefing block, hints,
 *   and submission form.
 *
 * All layouts share the nav bar, progression line, and client script.
 * The script reads optional data-msg-* form attributes for per-challenge copy.
 */
import Layout from '../../../layouts/Layout.astro';
import { and, eq } from 'drizzle-orm';
import { createDb } from '../../../lib/db/client';
import { getEnv } from '../../../lib/runtime';
import { ensureCurrentEventState } from '../../../lib/event/state';
import { canAccessCompetition } from '../../../lib/event/access';
import { challenges } from '../../../lib/db/schema';
import {
	getPublicChallengeData,
	getEventRoster,
	getChallengeAccessStatus,
	parseSlot,
	InvalidSlotError,
	type PublicChallengeData,
} from '../../../lib/challenges';
import { getRevealedHints, MAX_HINTS } from '../../../lib/hints';
import type { Q1Public } from '../../../../challenges/01/index';
import type { Q2Public } from '../../../../challenges/02/index';
import type { Q3Public } from '../../../../challenges/03/index';
import type { Q4Public } from '../../../../challenges/04/index';
import type { Q5Public } from '../../../../challenges/05/index';
import type { Q6Public, DirectoryEntry } from '../../../../challenges/06/index';
import type { Q7Public } from '../../../../challenges/07/index';
import type { Q8Public } from '../../../../challenges/08/index';
import type { Q9Public } from '../../../../challenges/09/index';
import type { Q11Public } from '../../../../challenges/11/index';

export const prerender = false;

// ── Auth ──────────────────────────────────────────────────────────────────────
const slug = Astro.params.event!;
const auth = Astro.locals.auth;

if (!auth || auth.event.slug !== slug) {
	return Astro.redirect(`/${slug}/login`);
}

// ── Event state ───────────────────────────────────────────────────────────────
const db = createDb(getEnv().DB);
const now = new Date();
const event = await ensureCurrentEventState(db, auth.event, now);

if (!canAccessCompetition(event, now)) {
	return Astro.redirect(`/${slug}/home`);
}

// ── Slot resolution ───────────────────────────────────────────────────────────
let slot: number;
try {
	slot = parseSlot(Astro.params.slot);
} catch (e) {
	if (e instanceof InvalidSlotError) return new Response('Not found', { status: 404 });
	throw e;
}

const status = getChallengeAccessStatus(auth.participant, slot);
if (status === 'locked') {
	return Astro.redirect(`/${slug}/challenge/${auth.participant.currentChallenge}`);
}

// ── Challenge data ────────────────────────────────────────────────────────────
const roster = await getEventRoster(db, event.id);

let view: PublicChallengeData;
try {
	view = await getPublicChallengeData(
		{ env: getEnv(), event, rollNumber: auth.participant.rollNumber, roster },
		slot,
	);
} catch {
	return new Response('Challenge temporarily unavailable', { status: 500 });
}

// ── Hints ─────────────────────────────────────────────────────────────────────
const challengeRow = await db
	.select({ id: challenges.id })
	.from(challenges)
	.where(and(eq(challenges.eventId, event.id), eq(challenges.slot, slot)))
	.get();

const revealedHints = challengeRow
	? await getRevealedHints(db, event.id, auth.participant.id, challengeRow.id, slot)
	: [];

// ── Derived state ─────────────────────────────────────────────────────────────
const isCurrent   = status === 'current';
const isSolved    = status === 'solved';
const nextHint    = revealedHints.length + 1;
const roll        = auth.participant.rollNumber;
const slotLabel   = String(view.slot).padStart(2, '0');
const progressPct = Math.round((view.slot / 30) * 100);

// ── Layout discriminants ──────────────────────────────────────────────────────
const isQ1 = view.key === 'the-assignment';
const isQ2 = view.key === 'eleven-years-cold';
const isQ3 = view.key === 'the-last-notebook';
const isQ4 = view.key === 'the-estate-record';
const isQ5 = view.key === 'marrow-house';
const isQ6 = view.key === 'the-directory';
const isQ7 = view.key === 'the-seventh-figure';
const isQ8 = view.key === 'lot-47';
const isQ9  = view.key === 'the-catalogue';
const isQ11 = view.key === 'verified';

// Q12–Q30 discriminants
const isQ12 = view.key === 'the-file-clerk';
const isQ13 = view.key === 'the-holt-collection';
const isQ14 = view.key === 'the-pre-vale-dates';
const isQ15 = view.key === 'the-memo';
const isQ16 = view.key === 'there-were-six';
const isQ17 = view.key === 'the-dead-website';
const isQ18 = view.key === 'for-you';
const isQ19 = view.key === 'the-same-file';
const isQ20 = view.key === 'mira-remembered-too';
const isQ21 = view.key === 'access-granted';
const isQ22 = view.key === 'the-alibi';
const isQ23 = view.key === 'miras-last-recording';
const isQ24 = view.key === 'case-closed';
const isQ25 = view.key === '1963';
const isQ26 = view.key === 'daniel-reyes-again';
const isQ27 = view.key === 'stop-looking-for-people';
const isQ28 = view.key === 'the-ledger';
const isQ29 = view.key === 'the-continuity';
const isQ30 = view.key === 'the-subject';

// Shell group membership
// Shell A — Archive / System Terminal (Q12, Q16, Q17, Q21, Q22)
const isShellA = isQ12 || isQ16 || isQ17 || isQ21 || isQ22;
// Shell B — Document Examination (Q13, Q14, Q15, Q18, Q19, Q27)
const isShellB = isQ13 || isQ14 || isQ15 || isQ18 || isQ19 || isQ27;
// Shell C — Forensic Evidence (Q20, Q23, Q25, Q26)
const isShellC = isQ20 || isQ23 || isQ25 || isQ26;
// Shell D — Case Synthesis Board (Q24)
const isShellD = isQ24;
// Shell E — The Ledger (Q28)
const isShellE = isQ28;
// Shell F — THE CONTINUITY (Q29, Q30)
const isShellF = isQ29 || isQ30;

const isCustomQ12to30 = isShellA || isShellB || isShellC || isShellD || isShellE || isShellF;

// Per-challenge UI metadata for custom shells
type QMeta = {
	systemLabel: string;
	sourceRef:   string;
	promptLabel: string;
	placeholder: string;
	msgVerifying: string;
	msgCorrect:   string;
	msgIncorrect: string;
	solvedMsg:    string;
};
const QMETA: Record<string, QMeta> = {
	'the-file-clerk':          { systemLabel: 'Vale Archive File System',                       sourceRef: 'Investigator file access · Case 71-C',            promptLabel: 'Archive Listing',          placeholder: 'Active file reference (e.g. vale-estate-inventory)',        msgVerifying: 'Checking archive index…',                       msgCorrect: 'File reference confirmed. Archive entry locked.',                        msgIncorrect: 'Reference not found. Check the active file listing.',                              solvedMsg: 'File reference confirmed. Archive entry locked.' },
	'the-holt-collection':     { systemLabel: 'Blackwood Evidence Management',                  sourceRef: 'Document EVD-71C-HOLT · Ownership history',        promptLabel: 'Recovered Document',       placeholder: 'Name of original 1948 owner',                               msgVerifying: 'Cross-referencing ownership records…',          msgCorrect: 'Owner identified. Provenance record filed.',                            msgIncorrect: 'Name not confirmed. Check the restored title carefully.',                          solvedMsg: 'Original owner confirmed. This document record is now read-only.' },
	'the-pre-vale-dates':      { systemLabel: 'Blackwood Evidence Management',                  sourceRef: 'Ledger cipher · Decoded acquisition dates',        promptLabel: 'Cipher Document',          placeholder: 'Pre-Vale acquisition date (YYYY-MM-DD)',                    msgVerifying: 'Verifying date against the ledger…',            msgCorrect: 'Date confirmed. Ledger entry filed.',                                   msgIncorrect: 'Date not recognised. Check your cipher decode.',                                   solvedMsg: 'Date confirmed. This ledger entry is now read-only.' },
	'the-memo':                { systemLabel: 'Blackwood Evidence Management',                  sourceRef: 'MEMO-published.html · Version comparison',         promptLabel: 'Document',                 placeholder: 'Year buried in the source (e.g. 2001)',                     msgVerifying: 'Verifying year against source record…',         msgCorrect: 'Year confirmed. Archive discrepancy filed.',                            msgIncorrect: 'Year not confirmed. Check all versions of the memo.',                              solvedMsg: 'Version discrepancy confirmed. This record is now read-only.' },
	'there-were-six':          { systemLabel: 'Vale Archive Photograph Record',                 sourceRef: 'Photograph comparison · Case 71-C',               promptLabel: 'Photograph Analysis',      placeholder: 'EXIF modification timestamp (YYYY:MM:DD HH:MM:SS)',         msgVerifying: 'Verifying against photograph metadata…',        msgCorrect: 'Timestamp confirmed. Photograph alteration logged.',             msgIncorrect: 'Timestamp not confirmed. Check the EXIF data on the current image.', solvedMsg: 'Alteration timestamp confirmed. This photograph record is now read-only.' },
	'the-dead-website':        { systemLabel: 'Web Archive — Vale Estate Site',                 sourceRef: 'Last-Modified header · Archive retrieval',         promptLabel: 'Archive Response',         placeholder: 'Last-Modified date (YYYY-MM-DD)',                           msgVerifying: 'Checking archive header…',                      msgCorrect: 'Date confirmed. Archive record closed.',                                msgIncorrect: 'Date not confirmed. Check the Last-Modified header precisely.',                    solvedMsg: 'Last-Modified date confirmed. This archive record is now read-only.' },
	'for-you':                 { systemLabel: 'Blackwood Evidence Management',                  sourceRef: 'Recovered voicemail · Forensic audio transcript',  promptLabel: 'Voicemail Transcript',     placeholder: 'Phrase embedded in the recording (capitals)',               msgVerifying: 'Cross-referencing audio record…',               msgCorrect: 'Phrase confirmed. Audio evidence filed.',                               msgIncorrect: 'Phrase not recognised. Check the voicemail transcript carefully.',                 solvedMsg: 'Spoken phrase confirmed. This audio record is now read-only.' },
	'the-same-file':           { systemLabel: 'Blackwood Evidence Management',                  sourceRef: 'MEMO-published.html · v1 vs v2 comparison',       promptLabel: 'Comparison Report',        placeholder: 'Statement altered between versions',                        msgVerifying: 'Verifying against document record…',            msgCorrect: 'Statement confirmed. Archive discrepancy logged.',                      msgIncorrect: 'Statement not confirmed. Compare v1 and v2 of the memo carefully.',                solvedMsg: 'Altered statement confirmed. This comparison record is now read-only.' },
	'mira-remembered-too':     { systemLabel: 'Blackwood Forensic Evidence Unit',               sourceRef: "Cipher artifact · Mira's recovered notes",         promptLabel: 'Cipher Artifact',          placeholder: 'Decoded cipher message (capitals)',                          msgVerifying: 'Verifying cipher decode…',                      msgCorrect: 'Message confirmed. Cipher artifact filed.',                             msgIncorrect: 'Message not confirmed. Check your key and decode again.',                          solvedMsg: 'Cipher message confirmed. This artifact record is now read-only.' },
	'access-granted':          { systemLabel: 'Vale Archive Portal — Audit Log',                sourceRef: 'SQLi result · audit_log table · Case 71-C',        promptLabel: 'Injected Query Result',    placeholder: 'Timestamp of elevated write action (YYYY-MM-DD HH:MM)',    msgVerifying: 'Matching against audit record…',                msgCorrect: 'Timestamp confirmed. Audit log filed.',                                 msgIncorrect: 'Timestamp not recognised. Check the injected result precisely.',                   solvedMsg: 'Audit timestamp confirmed. This log entry is now read-only.' },
	'the-alibi':               { systemLabel: 'Transit + Building Access Cross-Reference',      sourceRef: 'Alibi verification · Case 71-C',                   promptLabel: 'Cross-Reference Output',   placeholder: 'Location confirmed during the write window',                msgVerifying: 'Cross-referencing access records…',             msgCorrect: 'Location confirmed. Alibi destroyed. Log filed.',                       msgIncorrect: 'Location not confirmed. Cross-reference both record sets.',                        solvedMsg: 'Location confirmed. This cross-reference is now read-only.' },
	'miras-last-recording':    { systemLabel: 'Blackwood Forensic Evidence Unit',               sourceRef: 'Audio evidence · mira-recording-2015-05.wav',      promptLabel: 'Forensic Audio Report',    placeholder: 'Name recovered from the audio segment',                    msgVerifying: 'Verifying against forensic audio report…',     msgCorrect: 'Name confirmed. Audio evidence filed.',                                 msgIncorrect: 'Name not confirmed. Apply the forensic filter and listen again.',                  solvedMsg: 'Audio evidence confirmed. This forensic record is now read-only.' },
	'case-closed':             { systemLabel: 'Blackwood Bureau — Case Board',                  sourceRef: 'Synthesis · Case 71-C · All evidence threads',     promptLabel: 'Case Board',               placeholder: 'Full name of person responsible',                           msgVerifying: 'Filing case conclusion with the Bureau…',       msgCorrect: 'Case closed. Record filed with the Bureau.',                            msgIncorrect: 'Name not confirmed. All four evidence threads must agree.',                        solvedMsg: 'Case conclusion filed. This board is now read-only.' },
	'1963':                    { systemLabel: 'Blackwood Forensic Evidence Unit',               sourceRef: 'Photograph provenance · Three-source verification',promptLabel: 'Verification Report',      placeholder: 'Year the photograph dates to',                              msgVerifying: 'Verifying against three independent sources…',  msgCorrect: 'Year confirmed. Photograph evidence filed.',                            msgIncorrect: 'Year not confirmed. All three sources must agree.',                                solvedMsg: 'Date confirmed. This photograph record is now read-only.' },
	'daniel-reyes-again':      { systemLabel: 'Blackwood Bureau — Personnel Archive',           sourceRef: 'Enumeration result · Case 71-C',                   promptLabel: 'Search Result',            placeholder: 'Number of distinct records',                                msgVerifying: 'Counting distinct records…',                    msgCorrect: 'Count confirmed. Personnel anomaly logged.',                            msgIncorrect: 'Count not confirmed. Count distinct records, not distinct mentions.',              solvedMsg: 'Record count confirmed. This archive entry is now read-only.' },
	'stop-looking-for-people': { systemLabel: 'Blackwood Evidence Management',                  sourceRef: "Mira Castellan · Notebook final page (v3)",        promptLabel: 'Notebook — Final Page',    placeholder: 'Second sentence from the final note (start: FOLLOW…)',     msgVerifying: "Filing Mira's instruction…",                    msgCorrect: 'Instruction confirmed. Notebook entry filed.',                          msgIncorrect: 'Instruction not confirmed. Submit the second sentence exactly.',                   solvedMsg: 'Final instruction confirmed. This notebook entry is now read-only.' },
	'the-ledger':              { systemLabel: 'The Ledger — Historical Records Database',       sourceRef: 'Access via Blackwood Case 71-C',                   promptLabel: 'Database Output',          placeholder: 'Role currently unassigned in Cycle 6',                     msgVerifying: 'Querying Ledger record…',                       msgCorrect: 'Role confirmed. Ledger entry sealed.',                                  msgIncorrect: "Role not confirmed. Identify the PENDING role that fits the Investigator's structural position.", solvedMsg: 'Role confirmed. The Ledger record is now sealed and read-only.' },
	'the-continuity':          { systemLabel: 'Blackwood Evidence Correlation Terminal',        sourceRef: 'Restricted access — Senior Investigator only',     promptLabel: 'Terminal Output',          placeholder: 'Name of the system',                                        msgVerifying: 'Filing system identification…',                 msgCorrect: 'System identified. Case continuity resolved.',                          msgIncorrect: 'System not identified. Assemble the doctrine and infer the name from the TC prefix.', solvedMsg: 'System identified. Continuity resolved. This terminal is now read-only.' },
	'the-subject':             { systemLabel: 'THE CONTINUITY',                                 sourceRef: 'Final record — Cycle 6, current',                  promptLabel: 'Final Query',              placeholder: 'Your investigator codename',                                msgVerifying: 'Querying Continuity record…',                   msgCorrect: 'Identity confirmed. The Continuity record is complete.',                msgIncorrect: 'Codename not confirmed. Look at what you were told before the case began.', solvedMsg: 'Identity confirmed. The Continuity record is complete.' },
};
const qm: QMeta | null = isCustomQ12to30 ? (QMETA[view.key] ?? null) : null;
// Shared prompt+token view for all custom Q12-Q30 shells
type GenericPub = { prompt: string; token: string };
const cp = isCustomQ12to30 ? (view.publicData as GenericPub) : null;
// Q18 typed accessor — includes phraseB64 for TTS player
type Q18GenericPub = { prompt: string; token: string; phraseB64: string };
const q18pub = isQ18 ? (view.publicData as Q18GenericPub) : null;

const q1  = isQ1  ? (view.publicData as Q1Public)  : null;
const q2  = isQ2  ? (view.publicData as Q2Public)  : null;
const q3  = isQ3  ? (view.publicData as Q3Public)  : null;
const q4  = isQ4  ? (view.publicData as Q4Public)  : null;
const q5  = isQ5  ? (view.publicData as Q5Public)  : null;
const q6  = isQ6  ? (view.publicData as Q6Public)  : null;
const q7  = isQ7  ? (view.publicData as Q7Public)  : null;
const q8  = isQ8  ? (view.publicData as Q8Public)  : null;
const q9  = isQ9  ? (view.publicData as Q9Public)  : null;
const q11 = isQ11 ? (view.publicData as Q11Public) : null;

// Generic public data shape for Q10 only (prompt + token).
// Q11 and Q12–Q30 have their own custom layouts (excluded here).
const gp = (!isQ1 && !isQ2 && !isQ3 && !isQ4 && !isQ5 && !isQ6 && !isQ7 && !isQ8 && !isQ9 && !isQ11 && !isCustomQ12to30) ? (view.publicData as GenericPub) : null;

// ── Q2 hidden archive comment ─────────────────────────────────────────────────
// The reconciliation note is injected into the page via set:html so it
// appears in the delivered HTML source and DevTools, but is not rendered
// visually. Participants discover it by inspecting the page.
// EVD-71C-017 is the suppressed evidence reference; it is the Q2 answer.
const q2ArchiveNote = isQ2
	? [
		'<!--',
		'  ARCHIVE SYSTEM \u2014 RECONCILIATION NOTE (auto-generated)',
		'  Case 71-C: 1 evidence item omitted from rendered display.',
		'  Reference: EVD-71C-017 | Type: personal materials | Classification: RESTRICTED',
		'  Item suppressed pending classification review.',
		'  To request access: case-archive [internal routing only].',
		'-->',
	  ].join('\n')
	: '';

// ── Generic tier colours (Q3–Q30) ─────────────────────────────────────────────
const TIER_STYLE = {
	easy:     { badge: 'bg-emerald-950/60 text-emerald-400  border-emerald-800/50' },
	medium:   { badge: 'bg-amber-950/60   text-amber-400    border-amber-800/50'   },
	hard:     { badge: 'bg-red-950/60     text-red-400      border-red-800/50'     },
	capstone: { badge: 'bg-neutral-900    text-neutral-100  border-neutral-500'    },
} as const;
const ts = TIER_STYLE[view.tier as keyof typeof TIER_STYLE] ?? TIER_STYLE.easy;
---

<Layout title={`Case 71-C · Q${slotLabel} — ${view.title}`}>
<div class="relative min-h-screen bg-neutral-950 text-neutral-100">

	<!-- ── Shared navigation bar ──────────────────────────────────────────── -->
	<nav class="sticky top-0 z-20 border-b border-neutral-800/70 bg-neutral-950/95 backdrop-blur-sm">
		<div class="mx-auto flex h-10 max-w-3xl items-center justify-between px-5">

			<a href={`/${slug}/home`}
			   class="flex items-center gap-1.5 font-mono text-[10px] tracking-[0.15em] text-neutral-600 transition-colors hover:text-neutral-400 uppercase">
				← Bureau
			</a>

			<div class="flex items-center gap-3 font-mono text-[10px] tracking-[0.2em]">
				<span class="text-neutral-700">CASE</span>
				<span class="text-neutral-500">71-C</span>
				<span class="text-neutral-800">·</span>
				<span class="text-neutral-700">Q{slotLabel} / 30</span>
			</div>

			<span class="font-mono text-[10px] tracking-[0.1em] text-neutral-700">
				INV-{roll}
			</span>
		</div>
		<!-- Case progress line -->
		<div class="h-px w-full bg-neutral-800">
			<div class="h-full bg-neutral-600/50 transition-all duration-700"
			     style={`width: ${progressPct}%`}></div>
		</div>
	</nav>

	<!-- ══════════════════════════════════════════════════════════════════════ -->
	<!-- Q1 — INSTITUTIONAL ASSIGNMENT MEMO                                   -->
	<!-- ══════════════════════════════════════════════════════════════════════ -->

	{isQ1 && q1 && (
		<main
			class="mx-auto w-full max-w-2xl px-4 py-10"
			data-challenge
			data-slug={slug}
			data-slot={view.slot}
		>
			<div class="overflow-hidden rounded border border-neutral-800 bg-neutral-900">

				<!-- Bureau letterhead -->
				<div class="border-b border-neutral-800 px-7 py-5">
					<p class="font-mono text-xs font-medium tracking-[0.3em] text-neutral-300 uppercase">
						Blackwood Investigative Bureau
					</p>
					<p class="mt-1 font-mono text-[10px] tracking-[0.2em] text-neutral-600 uppercase">
						Case Management Division &nbsp;·&nbsp; Internal System
					</p>
				</div>

				<!-- Memo header -->
				<div class="border-b border-neutral-800 px-7 py-6">
					<p class="mb-5 font-mono text-[10px] tracking-[0.3em] text-neutral-600 uppercase">
						Internal Memorandum
					</p>

					<dl class="grid grid-cols-[4.5rem_1fr] gap-x-5 gap-y-2">
						<dt class="font-mono text-[10px] tracking-[0.1em] text-neutral-600 uppercase self-start pt-px">Date</dt>
						<dd class="font-mono text-xs text-neutral-400">{q1.issuedOn}</dd>
						<dt class="font-mono text-[10px] tracking-[0.1em] text-neutral-600 uppercase self-start pt-px">Case</dt>
						<dd class="font-mono text-xs text-neutral-400">71-C &nbsp;—&nbsp; COLD CASE REASSIGNMENT</dd>
						<dt class="font-mono text-[10px] tracking-[0.1em] text-neutral-600 uppercase self-start pt-px">Session</dt>
						<dd class="font-mono text-[11px] tracking-[0.18em] text-neutral-600">{q1.sessionToken}</dd>
					</dl>

					<div class="my-5 border-t border-neutral-800/60"></div>

					<dl class="grid grid-cols-[4.5rem_1fr] gap-x-5 gap-y-2">
						<dt class="font-mono text-[10px] tracking-[0.1em] text-neutral-600 uppercase self-start pt-px">To</dt>
						<dd>
							<p class="font-mono text-sm font-semibold tracking-[0.12em] text-neutral-100">{q1.designation}</p>
							<p class="mt-0.5 font-mono text-[10px] text-neutral-600">Investigator &nbsp;/&nbsp; Roll {q1.rollNumber}</p>
						</dd>
						<dt class="font-mono text-[10px] tracking-[0.1em] text-neutral-600 uppercase self-start pt-px">From</dt>
						<dd class="font-mono text-xs text-neutral-500">Case Management Division</dd>
						<dt class="font-mono text-[10px] tracking-[0.1em] text-neutral-600 uppercase self-start pt-px">Re</dt>
						<dd class="font-mono text-xs text-neutral-500">Mira Castellan &nbsp;—&nbsp; Missing Persons (Cold Case)</dd>
					</dl>
				</div>

				<!-- Memo body -->
				<div class="border-b border-neutral-800 px-7 py-7 space-y-4">
					<p class="text-sm leading-relaxed text-neutral-400">
						This bureau has received administrative direction to reopen file 71-C,
						originally logged in October 2015. The file concerns the disappearance
						of Mira Castellan, a freelance investigator contracted to catalogue and
						appraise the estate of Silas Vale following his death in the early part
						of this decade.
					</p>
					<p class="text-sm leading-relaxed text-neutral-400">
						Castellan's engagement was routine in scope. She was tasked with
						documenting a private collection of historical objects — folk craft,
						archival materials, and estate correspondence accumulated by the Vale
						family over several decades. Her appraisal proceeded without incident
						for approximately four months before contact with her ceased entirely.
					</p>
					<p class="text-sm leading-relaxed text-neutral-400">
						The original investigation returned no cause, no evidence of foul play,
						and no body. The case was classified unsolved and filed as 71-C.
						It has remained inactive for eleven years.
					</p>
					<p class="text-sm leading-relaxed text-neutral-400">
						You have been assigned as the reviewing investigator. All available case
						materials are accessible through the standard archive system. Some
						portions of the original file are incomplete; this is noted where
						applicable.
					</p>
				</div>

				<!-- Subject record -->
				<div class="border-b border-neutral-800 bg-neutral-950/50 px-7 py-5">
					<p class="mb-3 font-mono text-[10px] tracking-[0.25em] text-neutral-600 uppercase">Subject Record</p>
					<dl class="grid grid-cols-[8rem_1fr] gap-x-5 gap-y-1.5">
						<dt class="font-mono text-[10px] text-neutral-700">Name</dt>
						<dd class="font-mono text-xs text-neutral-300">{q1.subjectName}</dd>
						<dt class="font-mono text-[10px] text-neutral-700">Last known</dt>
						<dd class="font-mono text-xs text-neutral-500">{q1.subjectLastSeen}</dd>
						<dt class="font-mono text-[10px] text-neutral-700">Status</dt>
						<dd class="font-mono text-xs text-neutral-600">{q1.subjectStatus}</dd>
						<dt class="font-mono text-[10px] text-neutral-700">File</dt>
						<dd class="font-mono text-[10px] text-neutral-700">71-C &nbsp;/&nbsp; BLACKWOOD INVESTIGATIVE BUREAU</dd>
					</dl>
				</div>

				<!-- Revealed hints -->
				<div
					data-hints
					class={revealedHints.length === 0 ? 'hidden' : 'border-b border-neutral-800 px-7 py-4'}
				>
					<ul class="space-y-2" data-hint-list>
						{revealedHints.map((h) => (
							<li class="flex gap-4" data-hint-number={h.hintNumber}>
								<span class="shrink-0 font-mono text-[10px] text-neutral-700 uppercase pt-px">Note {h.hintNumber}</span>
								<span class="text-xs text-neutral-500 leading-relaxed">{h.text}</span>
							</li>
						))}
					</ul>
				</div>

				<!-- Solved state -->
				{isSolved && (
					<div class="px-7 py-5">

---
/**
 * GET /{event}/archive/{path}
 *
 * Hidden workshop page handler for Q5 — The Workshop.
 *
 * Handles the path discovered via robots.txt Disallow:
 *   /{event}/archive/BPHA-{archiveToken}-workshop/
 *
 * The page renders a full historical article about Ashwick Figureworks
 * (Josiah Marrow's workshop, 1871–1889), styled as a page from the
 * Pembridge Local Heritage amateur history site.
 *
 * Access control:
 *   - Requires authenticated participant for this event.
 *   - Requires Q5 to be unlocked (currentChallenge >= 5).
 *   - Validates that {path} matches this participant's archivePath.
 *   - All other paths (including path collisions by other participants)
 *     return 404.
 *
 * This page does NOT use the shared Blackwood Layout — it renders as a
 * page on the Pembridge Local Heritage site (distinct visual identity).
 * A discreet "Return to investigation" link is included at the bottom.
 *
 * Q6 lead: the workshop article references the Ashwick Trades Directory
 * with sequential entry identifiers starting at D-001.
 */
import { createDb } from '../../../lib/db/client';
import { getEnv } from '../../../lib/runtime';
import { ensureCurrentEventState } from '../../../lib/event/state';
import { canAccessCompetition } from '../../../lib/event/access';
import {
	getPublicChallengeData,
	getEventRoster,
	canAccessChallenge,
} from '../../../lib/challenges';

export const prerender = false;

const slug = Astro.params.event!;
const rawPath = Astro.params.path ?? '';
// Normalize: strip trailing slash, lower-case for comparison.
const requestedPath = rawPath.replace(/\/$/, '');

const auth = Astro.locals.auth;

// ── Auth ─────────────────────────────────────────────────────────────────────
if (!auth || auth.event.slug !== slug) {
	return Astro.redirect(`/${slug}/login`);
}

// ── Event state ───────────────────────────────────────────────────────────────
const db = createDb(getEnv().DB);
const now = new Date();
const event = await ensureCurrentEventState(db, auth.event, now);

if (!canAccessCompetition(event, now)) {
	return Astro.redirect(`/${slug}/home`);
}

// ── Q5 progression gate ───────────────────────────────────────────────────────
if (!canAccessChallenge(auth.participant, 5)) {
	return new Response('Not found', { status: 404 });
}

// ── Validate path against participant's archive path ──────────────────────────
const roster = await getEventRoster(db, event.id);
const view = await getPublicChallengeData(
	{ env: getEnv(), event, rollNumber: auth.participant.rollNumber, roster },
	5,
);
const pub = view.publicData as { archivePath: string };
const expectedPath = pub.archivePath; // e.g. "BPHA-1847-workshop"

if (requestedPath !== expectedPath) {
	return new Response('Not found', { status: 404 });
}

---
/**
 * Live Scoreboard — real-time CTF competition leaderboard.
 * Connects to /api/scoreboard-sse for live updates.
 * Shows badge awards, team rankings, and solve feed.
 */
import Layout from '../layouts/Layout.astro';
---

<Layout title="Live Scoreboard — Case Files CTF">
  <div transition:animate="fade">
  <style>
    :root {
      --bg: #0a0e17;
      --card: #111827;
      --card-border: #1f2937;
      --accent: #22c55e;
      --accent-dim: rgba(34,197,94,0.15);
      --gold: #fbbf24;
      --silver: #94a3b8;
      --bronze: #d97706;
      --text: #e5e7eb;
      --text-dim: #6b7280;
      --badge-epic: #a855f7;
      --badge-rare: #3b82f6;
      --badge-legendary: #f59e0b;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { background: var(--bg); color: var(--text); font-family: 'JetBrains Mono', 'Fira Code', monospace; min-height: 100vh; }

    .header { text-align: center; padding: 3rem 1rem 1.5rem; }
    .header h1 { font-size: 2.5rem; font-weight: 800; background: linear-gradient(135deg, var(--accent), #3b82f6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .header .subtitle { color: var(--text-dim); margin-top: 0.5rem; font-size: 0.9rem; }
    .live-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); border-radius: 999px; padding: 4px 12px; font-size: 0.75rem; color: #ef4444; margin-top: 1rem; }
    .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #ef4444; animation: pulse 1.5s ease-in-out infinite; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.4;transform:scale(0.8)} }

    .container { max-width: 900px; margin: 0 auto; padding: 0 1rem 3rem; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } }

    .panel { background: var(--card); border: 1px solid var(--card-border); border-radius: 12px; padding: 1.5rem; }
    .panel-title { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-dim); margin-bottom: 1rem; }

    .leaderboard { list-style: none; }
    .leaderboard li { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--card-border); }
    .leaderboard li:last-child { border-bottom: none; }
    .rank { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; flex-shrink: 0; }
    .rank-1 { background: rgba(251,191,36,0.2); color: var(--gold); }
    .rank-2 { background: rgba(148,163,184,0.2); color: var(--silver); }
    .rank-3 { background: rgba(217,119,6,0.2); color: var(--bronze); }
    .rank-default { background: var(--card-border); color: var(--text-dim); }
    .team-name { flex: 1; font-weight: 600; }
    .team-score { font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }
    .team-badges { font-size: 0.8rem; color: var(--text-dim); }

    .feed { list-style: none; max-height: 350px; overflow-y: auto; }
    .feed li { padding: 10px 0; border-bottom: 1px solid var(--card-border); animation: slideIn 0.3s ease-out; }
    .feed li:last-child { border-bottom: none; }
    @keyframes slideIn { from { opacity:0; transform:translateY(-8px); } to { opacity:1; transform:translateY(0); } }
    .feed-type { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; margin-bottom: 4px; }
    .feed-solve { background: rgba(34,197,94,0.15); color: var(--accent); }
    .feed-badge { background: rgba(168,85,247,0.15); color: var(--badge-epic); }
    .feed-wrong { background: rgba(239,68,68,0.15); color: #ef4444; }
    .feed-detail { font-size: 0.8rem; color: var(--text-dim); }
    .feed-points { color: var(--accent); font-weight: 700; }

    .badge-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 0.5rem; }
    .badge-chip { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; }
    .badge-chip.epic { background: rgba(168,85,247,0.15); color: var(--badge-epic); border: 1px solid rgba(168,85,247,0.3); }
    .badge-chip.rare { background: rgba(59,130,246,0.15); color: var(--badge-rare); border: 1px solid rgba(59,130,246,0.3); }
    .badge-chip.legendary { background: rgba(245,158,11,0.15); color: var(--badge-legendary); border: 1px solid rgba(245,158,11,0.3); }

    .stat-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--card-border); }
    .stat-row:last-child { border-bottom: none; }
    .stat-label { color: var(--text-dim); font-size: 0.8rem; }
    .stat-value { font-weight: 700; font-variant-numeric: tabular-nums; }

    .empty { color: var(--text-dim); font-style: italic; padding: 2rem; text-align: center; }
  </style>

  <div class="header">
    <h1>Case Files CTF</h1>
    <p class="subtitle">Live Competition Scoreboard</p>
    <div class="live-badge"><span class="live-dot"></span> LIVE</div>
  </div>

  <div class="container">
    <!-- Stats bar -->
    <div class="panel" style="margin-bottom:1.5rem;">
      <div style="display:flex;justify-content:space-around;text-align:center;">
        <div><div class="stat-value" id="total-teams">0</div><div class="stat-label">Teams</div></div>
        <div><div class="stat-value" id="total-solves">0</div><div class="stat-label">Solves</div></div>
        <div><div class="stat-value" id="total-badges">0</div><div class="stat-label">Badges</div></div>
        <div><div class="stat-value" id="last-update">—</div><div class="stat-label">Last Update</div></div>
      </div>
    </div>

    <div class="grid">
      <!-- Leaderboard -->
      <div class="panel">
        <div class="panel-title">🏆 Leaderboard</div>
        <ol class="leaderboard" id="leaderboard">
          <li class="empty">Waiting for live data…</li>
        </ol>
      </div>

      <!-- Live Feed -->
      <div class="panel">
        <div class="panel-title">📡 Live Feed</div>
        <ul class="feed" id="feed">
          <li class="empty">No events yet</li>
        </ul>
      </div>
    </div>

    <!-- Badges -->
    <div class="panel" style="margin-top:1.5rem;">
      <div class="panel-title">🏅 Recent Badge Awards</div>
      <div class="badge-grid" id="badges">
        <span class="empty" style="width:100%;text-align:center;">No badges awarded yet</span>
      </div>
    </div>
  </div>

  <script>
    const feedEl = document.getElementById('feed')!;
    const leaderboardEl = document.getElementById('leaderboard')!;
    const badgesEl = document.getElementById('badges')!;

    const rankClass = (i: number) => i === 0 ? 'rank-1' : i === 1 ? 'rank-2' : i === 2 ? 'rank-3' : 'rank-default';

    let totalBadges = 0;

    function addFeedEvent(event: any) {
      const empty = feedEl.querySelector('.empty');
      if (empty) empty.remove();

      const li = document.createElement('li');
      const typeClass = event.type === 'solve' ? 'feed-solve' : event.type === 'badge_awarded' ? 'feed-badge' : 'feed-wrong';
      const typeLabel = event.type === 'solve' ? '✓ Solved' : event.type === 'badge_awarded' ? '🏅 Badge' : '✗ Wrong';

      li.innerHTML = `
        <span class="feed-type ${typeClass}">${typeLabel}</span>
        <div>${event.teamName} — ${event.challengeName}</div>
        <div class="feed-detail">${event.points > 0 ? `<span class="feed-points">+${event.points} pts</span>` : ''} ${event.badge ? `${event.badge.icon} ${event.badge.name}` : ''}</div>
      `;
      feedEl.insertBefore(li, feedEl.firstChild);

      if (event.type === 'badge_awarded') {
        totalBadges++;
        document.getElementById('total-badges')!.textContent = String(totalBadges);
        const chip = document.createElement('span');
        chip.className = `badge-chip ${event.badge?.rarity || 'epic'}`;
        chip.textContent = `${event.badge?.icon || '🏅'} ${event.badge?.name || 'Badge'}`;
        badgesEl.appendChild(chip);
      }

      // Keep feed under 50 items
      while (feedEl.children.length > 50) feedEl.removeChild(feedEl.lastChild!);
    }

    function updateLeaderboard(entries: any[]) {
      leaderboardEl.innerHTML = '';
      document.getElementById('total-teams')!.textContent = String(entries.length);
      document.getElementById('total-solves')!.textContent = String(entries.reduce((s, e) => s + e.solves, 0));

      entries.forEach((entry, i) => {
        const li = document.createElement('li');
        li.innerHTML = `
          <span class="rank ${rankClass(i)}">${entry.rank}</span>
          <span class="team-name">${entry.teamName}</span>
          <span class="team-badges">${entry.badgeCount > 0 ? `🏅${entry.badgeCount}` : ''}</span>
          <span class="team-score">${entry.score}</span>
        `;
        leaderboardEl.appendChild(li);
      });
    }

    // Connect to SSE
    let evtSource: EventSource;
    function connect() {
      evtSource = new EventSource('/api/scoreboard-sse');
      evtSource.onmessage = (e) => {
        try {
          const data = JSON.parse(e.data);
          if (data.top10) updateLeaderboard(data.top10);
          if (data.recentEvents) data.recentEvents.forEach((ev: any) => addFeedEvent(ev));
          if (data.lastUpdate) {
            const d = new Date(data.lastUpdate);
            document.getElementById('last-update')!.textContent = d.toLocaleTimeString();
          }
        } catch {}
      };
      evtSource.onerror = () => { evtSource.close(); setTimeout(connect, 3000); };
    }
    connect();
  </script>
  </div>
</Layout>
